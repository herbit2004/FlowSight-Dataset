# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
# cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────────────
# OpenRouter API key (used by all generation steps: crawl, synth, describe, qa, benchmark)
OPENROUTER_API_KEY=

# ── Optional: GitHub token ────────────────────────────────────────────────────
# Increases GitHub API rate limit during crawling (5000 req/hr vs 60 req/hr)
GITHUB_TOKEN=

# ── Generation model ─────────────────────────────────────────────────────────
# Model used for quality-check, file selection, description generation, and QA generation.
# Default: google/gemini-2.0-flash-001
GENERATION_MODEL=google/gemini-2.0-flash-001

# ── Benchmark evaluation models ───────────────────────────────────────────────
# Comma-separated list of OpenRouter model IDs to evaluate in the benchmark.
# Default (used when this variable is unset): all 6 models listed below.
BENCHMARK_MODELS=qwen/qwen3-vl-8b-instruct,qwen/qwen3-vl-30b-a3b-instruct,qwen/qwen3-vl-235b-a22b-instruct,qwen/qwen3-vl-8b-thinking,qwen/qwen3-vl-30b-a3b-thinking,qwen/qwen3-vl-235b-a22b-thinking
