# 复制本文件为 .env 并填入真实 key（.env 已被 gitignore，不会提交）
# cp .env.example .env

# OpenRouter API Key（必填，用于 build_dataset / run_benchmark / 合成数据等调模型）
OPENROUTER_API_KEY=

# GitHub Token（可选，用于 build_dataset 爬取时提高 API 限额）
GITHUB_TOKEN=

