graph TD
    A[User Places Order] --> B{Payment Received?};
    B -- Yes --> C[Prepare Shipment];
    B -- No --> H[Send Order Confirmation];
    C --> D{Items in Stock?};
    D -- Yes --> E[Ship Order];
    D -- No --> F[Notify Customer of Delay];
    E --> G[Update Inventory];
    F --> G;
    G --> A;
    H --> I[Generate Invoice];
    I --> J[Send Shipping Notification];
    J --> K[Order Delivered];
    K --> L[Close Out Order];