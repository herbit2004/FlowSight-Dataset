graph TD
    A[User Submits Incident Report] --> B{Severity Determined?};
    B -- Yes --> C[Incident Assign to Support];
    B -- No --> H[Incident Closed];
    C --> D{Support Resolves Incident?};
    D -- No --> E[Escalate Incident to Engineering];
    E --> F{Engineering Fixes Incident?};
    F -- Yes --> G[Deploy Fix to Production];
    G --> D;
    F -- No --> H;
    D -- Yes --> G;
    H --> I[Notify User of Resolution];
    I --> J[Incident Marked as Resolved];
    J --> A;