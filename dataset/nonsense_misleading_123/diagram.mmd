graph TD
    A[User Submits Order] --> B{Payment Received?};
    B -- No --> C[Display Error Message];
    C --> A; 
    B -- Yes --> D[Prepare Order];
    D --> E{Inventory Available?};
    E -- Yes --> F[Ship Order];
    F --> G[Order Delivered?];
    G -- No --> D; 
    E -- No --> H[Notify Customer of Delay];
    H --> I[Process Refund];
    I --> F;