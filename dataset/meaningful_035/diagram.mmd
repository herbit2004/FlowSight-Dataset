graph TD
    subgraph 用户积分等级系统
        A[用户行为事件] --> B{积分计算规则};
        B -- 符合规则 --> C[增加/减少用户积分];
        B -- 不符合规则 --> D[忽略];
        C --> E{等级评估条件};
        E -- 满足升级条件 --> F[等级提升];
        E -- 不满足升级条件 --> G[维持当前等级];
        F --> H[更新用户等级信息];
        G --> H;
        H --> I[触发等级变更通知];
        I --> J[记录等级变更日志];
        J --> K[数据统计与分析];
        K --> L{等级礼包/权益判断};
        L -- 有礼包/权益 --> M[发放等级礼包/权益];
        L -- 无礼包/权益 --> N[结束];
        M --> N;
        A --> O[风控策略检查];
        O -- 风险通过 --> B;
        O -- 风险拦截 --> P[记录风险事件];
        P --> N;
    end