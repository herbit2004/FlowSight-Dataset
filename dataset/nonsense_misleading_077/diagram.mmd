graph TD
    A[User Submits Incident Report] --> B{Severity Assessed?};
    B -- Yes --> C[Assign to Engineer];
    B -- No --> F[Incident Resolved?];
    C --> D{Engineer Investigates};
    D --> E{Reproducible?};
    E -- No --> H[Request More Information From User];
    E -- Yes --> G[Fix Implemented];
    G --> F;
    H --> A;
    F -- Yes --> C;
    F -- No --> I[Mark as Resolved];
    I --> J[Close Incident];
    J --> A;