graph TD
    subgraph 用户邀请裂变流程
    A[用户访问活动页] --> B{用户已登录？};
    B -- 是 --> C[获取用户邀请链接];
    B -- 否 --> D[提示登录/注册];
    D --> E[用户登录/注册];
    E --> C;
    C --> F[用户分享邀请链接];
    F --> G[新用户点击邀请链接];
    G --> H{新用户已注册？};
    H -- 是 --> I[跳转活动页];
    H -- 否 --> J[引导新用户注册];
    J --> K[注册成功];
    K --> I;
    I --> L[记录邀请关系];
    L --> M[检查奖励资格];
    M --> N{符合奖励条件？};
    N -- 是 --> O[发放奖励];
    N -- 否 --> P[不发放奖励];
    O --> Q[更新邀请数据];
    P --> Q;
    Q --> R[流程结束];
    end

    classDef highlight fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P highlight