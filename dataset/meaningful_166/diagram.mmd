graph TD
    subgraph 用户操作
        A[用户评论/点赞] --> B{权限校验};
        B -- 有权限 --> C[生成操作事件];
        B -- 无权限 --> Z[返回错误];
    end

    subgraph 事件处理
        C --> D(操作事件队列);
        D --> E{异步处理};
    end

    subgraph 异步处理流程
        E -- 是 --> F[风控检测];
        E -- 否 --> Z[返回错误];
        F -- 通过 --> G[持久化数据];
        F -- 拦截 --> Z[返回错误];
        G --> H[更新缓存];
        H --> I{通知模块};
    end

    subgraph 通知与后续处理
        I -- 评论通知 --> J[评论消息推送];
        I -- 点赞通知 --> K[点赞消息推送];
        J --> L[更新用户动态];
        K --> L;
        L --> M[完成];
    end

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,H,I,J,K,L process