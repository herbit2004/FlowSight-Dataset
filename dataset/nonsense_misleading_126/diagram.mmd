graph TD
    A[User Submits Order] --> B{Payment Received?};
    B -- No --> C[Send Order Confirmation];
    B -- Yes --> D[Inventory Check];
    D -- Available --> E[Fulfill Order];
    D -- Unavailable --> F[Notify Customer of Backorder];
    F --> G{Customer Accepts Backorder?};
    G -- Yes --> E;
    G -- No --> H[Cancel Order and Refund];
    H --> I[Update Inventory];
    E --> J[Packing and Shipping];
    J --> K{Shipping Successful?};
    K -- Yes --> I;
    K -- No --> L[Investigate Shipping Issue];
    L --> K;
    I --> M[Close Order];
    C --> M;
    M --> A;