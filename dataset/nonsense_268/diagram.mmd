graph TD
    A[用户请求] --> B(支付网关);
    B -- 失败 --> C{重试次数 < 3?};
    C -- Yes --> B;
    C -- No --> D[返回错误];
    B -- 成功 --> E[消息队列];
    E --> F{用户已登录?};
    F -- Yes --> G[查询数据库];
    F -- No --> H[更新缓存];
    H --> I[生成 Session];
    I --> A;
    G --> J[风控系统];
    J --> K{风控通过?};
    K -- Yes --> L[记录操作日志];
    K -- No --> M[返回风控拦截];
    L --> N[推送消息];
    N --> O(API 网关);
    O --> P[用户响应];
    M --> P;
    D --> P;

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style P fill:#f9f,stroke:#333,stroke-width:2px