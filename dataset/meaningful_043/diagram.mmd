graph TD
    A[用户查询输入];
    B[查询预处理];
    C[查询改写/纠错];
    D[构建查询树];
    E{选择索引策略};
    F[倒排索引查询];
    G[向量索引查询];
    H[结果合并与排序];
    I[文档加载];
    J[高亮标记];
    K[结果返回给用户];

    A --> B;
    B --> C;
    C --> D;
    D --> E;
    E -- 倒排索引 --> F;
    E -- 向量索引 --> G;
    F --> H;
    G --> H;
    H --> I;
    I --> J;
    J --> K;

    classDef process fill:#f9f,stroke:#333,stroke-width:2px;
    classDef decision fill:#ccf,stroke:#333,stroke-width:2px;
    class A,B,C,D,F,G,H,I,J process;
    class E decision;