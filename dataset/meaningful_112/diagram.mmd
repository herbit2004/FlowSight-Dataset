graph TD
    subgraph 会话初始化
        A[用户请求登录];
        B[身份验证服务];
        C{验证成功?};
    end

    subgraph 单点登录流程
        D[生成会话标识（Session ID）];
        E[颁发认证票据（Ticket）];
        F[存储会话信息];
        G[重定向到目标应用];
    end

    subgraph 应用接入
        H[目标应用接收票据];
        I[向认证服务验证票据];
        J{票据有效?};
        K[建立本地会话];
    end

    A --> B;
    B --> C;
    C -- 是 --> D;
    C -- 否 --> L[返回错误];

    D --> E;
    E --> F;
    F --> G;
    G --> H;
    H --> I;
    I --> J;
    J -- 是 --> K;
    J -- 否 --> M[拒绝访问];