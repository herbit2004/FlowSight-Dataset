graph TD
    subgraph 用户发起补偿申请
        A[用户提交补偿申请] --> B{是否符合自动补偿条件？};
    end

    B -- 是 --> C[自动补偿处理];
    C --> F[结束：补偿发放];

    B -- 否 --> D[人工审核队列];

    subgraph 人工审核
        D --> E{审核人员审核};
        E -- 通过 --> G[提交补偿方案];
        E -- 拒绝 --> H[拒绝补偿];
    end

    G --> I{风控校验};
    I -- 通过 --> J[补偿方案审批];
    I -- 拒绝 --> H

    J --> K{财务审批};
    K -- 通过 --> L[生成补偿单];
    K -- 拒绝 --> H

    L --> M[补偿单据分发];
    M --> N{选择补偿方式};
    N -- 现金 --> O[财务支付];
    N -- 积分 --> P[积分发放];
    N -- 其他 --> Q[其他方式补偿];

    O --> F;
    P --> F;
    Q --> F;
    H --> R[结束：补偿驳回];

    classDef flow fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,G,H,I,J,K,L,M,N,O,P,Q,R flow