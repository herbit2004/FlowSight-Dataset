graph TD
    subgraph 用户意图理解与查询改写
        A[用户输入];
        B[预处理：清洗、分词];
        C[意图识别];
        D[查询改写 - 纠错];
        E[查询改写 - 同义词扩展];
        F[查询改写 - 上下文补全];
    end

    subgraph 召回
        G[多路召回策略];
        H[实时热门商品召回];
        I[个性化推荐召回];
        J[基于类目的召回];
        K[基于关键词的召回];
    end

    subgraph 初步排序与过滤
        L[召回结果合并与去重];
        M[初步排序 - 简单模型];
        N[过滤 - 禁售/下架商品];
        O[过滤 - 黑名单商品];
        P[过滤 - 类目/品牌过滤];
    end

    subgraph 精排与重排序
        Q[精排模型];
        R[重排序 - 多样性];
        S[重排序 - 业务规则];
        T[重排序 - 个性化策略];
    end

    subgraph 结果展示
        U[结果包装与渲染];
        V[A/B测试];
        W[用户界面展示];
        X[埋点与日志];
    end

    A --> B;
    B --> C;
    B --> D;
    D --> E;
    E --> F;
    C --> G;
    F --> G;

    G --> H;
    G --> I;
    G --> J;
    G --> K;

    H --> L;
    I --> L;
    J --> L;
    K --> L;

    L --> M;
    L --> N;
    N --> O;
    O --> P;
    M --> Q;
    P --> Q;

    Q --> R;
    R --> S;
    S --> T;

    T --> U;
    U --> V;
    V --> W;
    W --> X;

    classDef input fill:#f9f,stroke:#333,stroke-width:2px
    classDef process fill:#ccf,stroke:#333,stroke-width:2px
    classDef output fill:#cfc,stroke:#333,stroke-width:2px

    class A,B,C,D,E,F input
    class G,H,I,J,K process
    class L,M,N,O,P process
    class Q,R,S,T process
    class U,V,W,X output