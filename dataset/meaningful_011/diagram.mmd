graph TD
    subgraph 集群共识层
    A[应用客户端] --> B{RedLock Manager};
    B -- 获取锁请求 --> C[Redis 集群];
    C -- 多数节点加锁成功 --> D{锁成功};
    C -- 部分节点加锁失败 --> E{锁失败};
    end

    subgraph 领导者选举
    F[启动时] --> G{尝试成为 Candidate};
    G -- 成为 Candidate --> H[发起选举投票];
    H --> I[其他 Candidate/Leader];
    I -- 同意投票 --> H;
    I -- 拒绝投票 --> J{投票失败};
    H -- 达到 Quorum --> K[成为 Leader];
    K --> L[执行 Leader 任务];
    L --> M[发送心跳];
    M --> K;
    J --> G;
    end

    D -- 锁有效 --> L;
    E -- 锁失败 --> A;

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style K fill:#ccf,stroke:#333,stroke-width:2px