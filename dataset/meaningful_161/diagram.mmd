graph TD
    subgraph 启动过程
        A[电源开启/重启] --> B(引导加载程序);
        B --> C{校验固件完整性?};
        C -- 是 --> D[加载并运行当前固件];
        C -- 否 --> E(进入恢复模式);
    end

    subgraph 正常运行
        D --> F(应用运行中);
        F --> G{接收到升级指令?};
        G -- 是 --> H[准备升级];
        G -- 否 --> F;
    end

    subgraph 升级流程
        H --> I[下载新固件];
        I --> J{校验新固件签名?};
        J -- 是 --> K[备份当前固件];
        J -- 否 --> E;
        K --> L[擦除旧固件];
        L --> M[写入新固件];
        M --> N{写入成功?};
        N -- 是 --> O[校验新固件完整性];
        N -- 否 --> E;
        O --> P[重启设备];
        P --> B;
    end
    E --> Q[等待固件更新];

    classDef error fill:#f9f,stroke:#333,stroke-width:2px;
    class E,Q error;