graph TD
    A[用户请求] --> B(数据库写入);
    B --> C{用户已登录?};
    C -- Yes --> D[支付网关];
    C -- No --> E[登录];
    E --> F(缓存写入);
    F --> A;
    D --> G{支付成功?};
    G -- Yes --> H[生成订单];
    G -- No --> I[通知用户支付失败];
    I --> D;
    H --> J(消息队列);
    J --> K[库存服务];
    K --> L{库存充足?};
    L -- Yes --> M[减少库存];
    L -- No --> N[通知用户库存不足];
    N --> K;
    M --> O[数据库读取];
    O --> P(API网关);
    P --> Q[外部服务];
    Q --> R(用户请求);
    R --> S[风控系统];
    S --> T{风控通过?};
    T -- Yes --> U[发送确认消息];
    T -- No --> V[取消订单];
    V --> J;
    U --> W[完成订单];
    W --> X(登出);
    X --> Y[推送通知];
    Y --> Z(读缓存);
    Z --> A;