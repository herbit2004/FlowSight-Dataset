graph TD
    subgraph 订单创建与支付流程
    A[用户发起订单] --> B{验证库存与优惠};
    B -- 库存充足 & 优惠有效 --> C[生成待支付订单];
    B -- 库存不足 --> E[提示库存不足];
    B -- 优惠失效 --> F[提示优惠已失效];
    C --> D{选择支付方式};
    D -- 微信支付 --> G[微信支付网关];
    D -- 支付宝支付 --> H[支付宝支付网关];
    G --> I[拉起微信支付];
    H --> J[拉起支付宝支付];
    I --> K{用户完成支付};
    J --> K
    K -- 支付成功 --> L[订单状态更新为已支付];
    K -- 支付失败 --> M[订单状态更新为待支付];
    L --> N[发送支付成功通知];
    M --> O[发送支付失败通知];
    N --> P[结束];
    O --> P;
    E --> P;
    F --> P;
    end

    classDef success fill:#90EE90,stroke:#333,stroke-width:2px;
    class L,N success