graph TD
    subgraph 数据接入与预处理
        A[用户行为事件];
        B[外部数据源];
        C[数据清洗与转换];
        D[特征工程];

        A --> C;
        B --> C;
        C --> D;
    end

    subgraph 规则引擎核心
        E[规则组加载与管理];
        F[规则执行器];
        G[风险评分计算];
        H[决策结果输出];

        D --> E;
        E --> F;
        F --> G;
        G --> H;
    end

    subgraph 策略决策与执行
        I[策略编排];
        J[策略优先级排序];
        K[策略执行];
        L[风控拦截/放行];
        M[生成事件报告];

        H --> I;
        I --> J;
        J --> K;
        K --> L;
        K --> M;
    end

    subgraph 监控与反馈
        N[实时监控指标];
        O[模型效果评估];
        P[规则优化与调整];
        Q[人工审核];

        M --> N;
        L --> N;
        N --> O;
        O --> P;
        P --> E;
        L --> Q;
        Q --> P;
    end

    subgraph 异常流程
        R[可疑交易检测];
        S[人工介入];

        L -- 可疑 --> R;
        R --> S;
        S --> Q;
    end

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P,Q,R,S process