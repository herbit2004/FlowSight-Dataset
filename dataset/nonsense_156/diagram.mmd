graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户已登录？};
    C -- Yes --> D[API 网关];
    C -- No --> E[登录];
    E --> F(缓存);
    F --> A;
    D --> G{支付成功？};
    G -- Yes --> H[消息队列];
    G -- No --> I[通知用户失败];
    H --> J[订单服务];
    J --> K(支付系统);
    K --> L[风控系统];
    L --> M{风控通过？};
    M -- Yes --> N[更新订单状态];
    M -- No --> O[终止支付];
    O --> K;
    N --> P[生成账单];
    P --> Q(用户);
    I --> Q;