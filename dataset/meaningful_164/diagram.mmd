graph TD
    A[开始：用户填写表单] --> B{关键字段校验？};
    B -- 是 --> C[前端校验：输入格式、长度等];
    C -- 通过 --> D{关联数据校验？};
    D -- 是 --> E[调用数据服务：唯一性、有效性等];
    E -- 通过 --> F[生成校验码];
    F --> G{校验码验证？};
    G -- 否 --> H[提示用户，返回C/E];
    G -- 是 --> I[提交数据到后端];
    B -- 否 --> I;
    D -- 否 --> F;
    I --> J[后端数据校验];
    J -- 通过 --> K[数据持久化];
    K --> L[返回成功消息];
    J -- 失败 --> M[返回失败消息];
    H --> B;
    M --> A;

    classDef passed fill:#ccffcc,stroke:#333,stroke-width:2px;
    class F,K passed;