graph TD
    subgraph 数据源
        A[Kafka Topic: UserActivity] --> B(预处理算子: 数据清洗与转换);
    end

    subgraph 窗口与聚合
        B --> C{滑动窗口: Session Window};
        C --> D[聚合算子: UV、DAU计算];
        D --> E{水位线控制};
    end

    subgraph 状态管理
        E -- 状态更新触发 --> F[状态后端: RocksDB];
        F --> E;
    end

    subgraph 结果输出
        E --> G[过滤算子: 结果过滤];
        G --> H{分支判断: 异常指标告警?};
        H -- 是 --> I[告警模块];
        H -- 否 --> J[结果持久化: ClickHouse];
    end
    
    subgraph 监控与告警
        K[监控指标: CPU、内存、延迟] --> L[告警策略];
        L --> I;
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style J fill:#ccf,stroke:#333,stroke-width:2px
    style I fill:#fcc,stroke:#333,stroke-width:2px

    classDef important fill:#f9f,stroke:#333,stroke-width:2px;
    class A,J important;

    classDef warning fill:#fcc,stroke:#333,stroke-width:2px;
    class I warning;

    classDef process fill:#fff,stroke:#333,stroke-width:1px;
    class B,C,D,E,F,G,H,K,L process;