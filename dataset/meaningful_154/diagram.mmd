graph TD
    subgraph 初始状态
        A[初始密钥: Key0]
    end

    B{计划轮换?} --> |是| C[生成新密钥: Key1];
    B --> |否| A;

    C --> D{Key1 预激活测试};
    D -- 通过 --> E[配置Key1到影子服务];
    D -- 失败 --> C;

    E --> F[影子服务验证Key1];
    F -- 成功 --> G[Key1正式生效];
    F -- 失败 --> C;

    G --> H[切换流量到Key1];
    H --> I[禁用并销毁Key0];

    subgraph 最终状态
        I --> J[当前密钥: Key1];
    end

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class A,C,E,G,I process