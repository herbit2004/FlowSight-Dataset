graph TD
    A[Referral Invitation Sent] --> B{User Accepts Invite?};
    B -- Yes --> C[New User Onboarding];
    B -- No --> D[Track Declined Invitation];
    C --> E{Initial Purchase?};
    E -- Yes --> F[Referral Reward Triggered];
    E -- No --> G[Nudge: Offer Discount];
    G --> H{Discount Used?};
    H -- Yes --> I[New User Purchase];
    H -- No --> J[Track User Inactivity];
    I --> F;
    F --> K[Referrer Reward Calculation];
    K --> L[Apply Reward to Referrer Account];
    D --> M[Analyze Declined Invitation Reason];
    M --> N[Improve Referral Messaging];
    J --> O[Consider Re-engagement Campaign];
    O --> P[Re-engagement Email Sent];

    classDef highlight fill:#fdd,stroke:#333,stroke-width:2px;
    class A,F,K highlight;