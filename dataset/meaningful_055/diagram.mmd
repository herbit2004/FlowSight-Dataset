graph TD
    subgraph 资源申请及审批流程
    A[申请人发起资源申请] --> B{资源类型选择与规格配置};
    B -- 计算资源 --> C1[提交计算资源申请];
    B -- 存储资源 --> C2[提交存储资源申请];
    B -- 网络资源 --> C3[提交网络资源申请];
    C1 --> D1[资源调度系统接收申请];
    C2 --> D2[存储管理系统接收申请];
    C3 --> D3[网络管理系统接收申请];
    D1 --> E{资源池容量充足？};
    D2 --> E;
    D3 --> E;
    E -- 是 --> F[自动审批通过];
    E -- 否 --> G[进入人工审批流程];
    F --> H{是否需要权限调整？};
    G --> H;
    H -- 是 --> I[权限管理系统审批];
    H -- 否 --> J[资源发放与配置];
    I --> J;
    J --> K[资源使用监控];
    K --> L{资源使用率超标预警？};
    L -- 是 --> M[触发自动扩容或人工干预];
    L -- 否 --> K;
    M --> K;
    K --> Z[资源申请流程结束];

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C1,C2,C3,D1,D2,D3,E,F,G,H,I,J,K,L,M,Z process
    end