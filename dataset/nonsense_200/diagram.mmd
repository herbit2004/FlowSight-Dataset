graph TD
    A[用户请求] --> B(数据库);
    B --> C{缓存命中?};
    C -- Yes --> D[返回用户响应];
    C -- No --> E[API 网关];
    E --> F{认证?};
    F -- No --> G[重定向到登录];
    F -- Yes --> H[鉴权];
    H --> I[风控系统];
    I -- 通过 --> J(消息队列);
    I -- 拒绝 --> K[返回错误];
    J --> L[支付系统];
    L --> M(数据库);
    M --> N[生成订单];
    N --> O[发送通知];
    O --> A;
    H --> P[数据分析];
    P --> H;
    style B fill:#f9f,stroke:#333,stroke-width:2px
    style M fill:#f9f,stroke:#333,stroke-width:2px