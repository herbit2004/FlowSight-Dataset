graph TD
    A[用户请求] --> B(数据库);
    B --> C{数据已存在?};
    C -- Yes --> D[删除缓存];
    C -- No --> E[读缓存];
    E --> F{缓存命中?};
    F -- Yes --> G[API 网关];
    F -- No --> H[更新数据库];
    H --> I[消息队列];
    I --> J{支付成功?};
    J -- Yes --> K[生成订单];
    J -- No --> L[重试支付];
    L --> I;
    G --> A;
    K --> M[用户响应];
    D --> A;