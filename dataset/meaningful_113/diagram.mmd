graph TD
    subgraph 聚合支付平台
    A[用户支付请求];
    B[创建支付订单];
    C[提交至第三方支付];
    D[第三方支付处理];
    E[第三方支付回调];
    F[回调验签与状态更新];
    G[通知商户系统];
    end

    subgraph 商户系统
    H[接收支付结果];
    I[更新用户订单状态];
    J[发起对账请求];
    K[接收对账文件];
    L[对账处理];
    M[生成对账差异报告];
    end

    subgraph 清算系统
    N[接收对账数据];
    O[生成清算报表];
    end

    A --> B;
    B --> C;
    C --> D;
    D --> E;
    E --> F;
    F --> G;
    G --> H;
    H --> I;
    I --> J;
    J --> N;
    N --> O;
    I --> L;
    L --> M;
    K --> L;

    classDef process fill:#f9f,stroke:#333,stroke-width:2px;
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O process;