graph TD
    subgraph 用户发起退换货流程
        A[用户提交申请] --> B{初步审核};
        B -- 通过 --> C[生成售后单];
        B -- 拒绝 --> Z[关闭申请];
    end

    C --> D{风控评估};
    D -- 通过 --> E[通知仓库];
    D -- 风险 --> F[人工介入];
    F --> G{二次审核};
    G -- 通过 --> E;
    G -- 拒绝 --> Z;

    E --> H[仓库确认];
    H -- 有货 --> I[分配服务商];
    H -- 无货 --> J[转为退款];

    I --> K[服务商上门取件];
    K --> L[质检];
    L -- 合格 --> M[入库];
    L -- 不合格 --> N[驳回申请];
    M --> O[财务结算];
    O --> P[完成退货];

    J --> Q[退款初审];
    Q -- 通过 --> R[财务复审];
    Q -- 拒绝 --> N;
    R --> S[退款执行];
    S --> T[完成退款];

    N --> U[通知用户];
    U --> Z;

    Z[流程结束];

    classDef green fill:#90EE90,stroke:#333,stroke-width:2px;
    class A,C,E,I,K,M,O,P,S,T green;