graph TD
    subgraph 用户行为
        A[用户触发优惠券领取事件] --> B(判断用户是否符合领取条件);
        B -- 符合 --> C{生成优惠券};
        B -- 不符合 --> D[提示用户不符合条件];
        C --> E{保存优惠券到用户账户};
        E --> F[用户获得优惠券];
    end

    subgraph 优惠券核销流程
        G[用户发起结算请求] --> H{检查用户是否有可用优惠券};
        H -- 有可用 --> I{选择优惠券};
        H -- 无可用 --> J[按原价结算];
        I --> K{计算优惠金额};
        K --> L{应用优惠};
        L --> M[生成支付单];
        M --> N{用户完成支付};
        N --> O[更新优惠券状态为已使用];
        O --> P[结算完成];
        J --> P
    end

    subgraph 系统模块
        S1[用户服务] --> B;
        S2[优惠券服务] --> C;
        S2 --> H;
        S3[结算服务] --> G;
        S3 --> K;
        S4[支付服务] --> M;
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style F fill:#f9f,stroke:#333,stroke-width:2px
    style P fill:#f9f,stroke:#333,stroke-width:2px

    classDef important fill:#ccf,stroke:#333,stroke-width:2px;
    class B,H,K important;