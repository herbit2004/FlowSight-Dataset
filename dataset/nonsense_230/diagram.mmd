graph TD
    A[用户请求] --> B(数据库);
    B --> C{缓存命中？};
    C -- Yes --> D[API 网关];
    C -- No --> E[写缓存];
    E --> B;
    D --> F{用户已登出？};
    F -- Yes --> G[登出];
    F -- No --> H[认证];
    H --> I(消息队列);
    I --> J[鉴权];
    J --> K{支付成功？};
    K -- Yes --> L[返回结果];
    K -- No --> M[重试支付];
    M --> J;
    L --> A;
    G --> A;