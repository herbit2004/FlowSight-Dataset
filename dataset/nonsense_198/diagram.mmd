graph TD
    A[用户请求] --> B(支付网关);
    B --> C{风控系统};
    C -- Yes --> D[更新缓存];
    C -- No --> E(生成订单);
    E --> F[发送支付通知];
    F --> G{用户确认支付};
    G -- Yes --> H[调用支付接口];
    G -- No --> I(取消订单);
    H --> J[支付结果通知];
    J --> K{支付成功};
    K -- Yes --> L[写入数据库];
    K -- No --> M(退款);
    L --> N[发送消息队列];
    N --> O[积分系统];
    O --> P(用户登出);
    P --> Q[用户请求];
    M --> R[财务系统];
    R --> S(数据库写入);
    S --> T[用户请求];

    subgraph 订单流程
        E --> F;
        F --> G;
        G --> H;
        G --> I;
        H --> J;
        J --> K;
        I --> X[记录取消日志];
        X --> N;
    end

    subgraph 支付成功后续流程
        K -- Yes --> L;
        L --> N;
        N --> O;
    end

    subgraph 支付失败流程
        K -- No --> M;
        M --> R;
        R --> S;
    end

    S --> T;
    style T fill:#f9f,stroke:#333,stroke-width:2px

    subgraph 安全检查
        A --> B;
        B --> C;
    end

    subgraph 账户登出后
        O --> P;
        P --> Q;

    end
    style Q fill:#f9f,stroke:#333,stroke-width:2px