graph TD
    subgraph 表单校验与提交流程
        A[用户填写表单] --> B{客户端校验？};
        B -- 是 --> C[客户端校验器];
        B -- 否 --> D[跳过客户端校验];

        C --> E{校验成功？};
        E -- 是 --> F[表单数据预处理];
        E -- 否 --> G[显示客户端错误信息];
        G --> A;

        F --> H[提交请求至服务器];
        D --> H;

        H --> I{服务器端校验？};
        I -- 是 --> J[服务器端校验器];
        I -- 否 --> K[跳过服务器端校验];

        J --> L{校验成功？};
        L -- 是 --> M[数据持久化];
        L -- 否 --> N[返回服务器端错误信息];
        N --> A;

        K --> M;

        M --> O[发送成功通知];
        O --> P[流程结束];
    end

    classDef success fill:#90EE90,stroke:#333,stroke-width:2px;
    classDef error fill:#FF6347,stroke:#333,stroke-width:2px;
    class A,F,H,M,O success;
    class G,N error;
    class B,C,E,I,J,L,D,K node;