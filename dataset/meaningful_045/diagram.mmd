graph TD
    subgraph 需求方
        A[客户端请求] --> B(配额预申请);
    end

    B --> C{配额中心};
    C -- 有配额 --> D[扣减配额];
    C -- 无配额 --> E[限流/排队];

    D --> F{缓存/DB更新};
    F -- 更新成功 --> G(允许请求);
    F -- 更新失败 --> E

    G --> H[后端服务];
    H --> I[响应客户端];

    E --> J[返回错误/排队中];
    J --> I

    subgraph 配额管理后台
        K[管理员操作] --> L(配额规则更新);
        L --> M{规则校验};
        M -- 校验通过 --> N[持久化存储];
        M -- 校验失败 --> O[返回错误信息];
        N --> P(通知配额中心);
        P --> C
    end

    classDef success fill:#afa,stroke:#333,stroke-width:2px;
    classDef error fill:#faa,stroke:#333,stroke-width:2px;
    class G,H,I,D,F success;
    class E,J,M,O error;