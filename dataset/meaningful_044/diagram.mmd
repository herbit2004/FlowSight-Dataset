graph TD
    subgraph TenantA [租户A]
        A1[API Gateway]
        A2[请求路由]
        A3[租户A计算集群]
        A4[租户A数据库]
    end

    subgraph TenantB [租户B]
        B1[API Gateway]
        B2[请求路由]
        B3[租户B计算集群]
        B4[租户B数据库]
    end

    API[外部请求] --> A1
    API --> B1
    A1 --> A2
    B1 --> B2
    A2 -- 租户A标识 --> A3
    B2 -- 租户B标识 --> B3
    A3 --> A4
    B3 --> B4

    classDef tenant fill:#f9f,stroke:#333,stroke-width:2px
    class TenantA,TenantB tenant