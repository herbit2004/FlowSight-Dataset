graph TD
    subgraph 服务注册与发现
        A[服务实例启动] --> B{是否已注册?}
        B -- 是 --> C[心跳保活]
        B -- 否 --> D[请求注册中心];
        D --> E[注册成功];
        E --> C;
        C --> F{心跳正常?}
        F -- 是 --> C;
        F -- 否 --> G[上报异常]
        G --> H[触发熔断/降级]
    end

    subgraph 服务调用
        I[客户端发起请求] --> J[服务发现];
        J --> K{可用实例列表?}
        K -- 否 --> L[返回错误];
        K -- 是 --> M[负载均衡选择实例];
        M --> N[发起调用];
        N --> O{调用成功?}
        O -- 是 --> P[返回结果];
        O -- 否 --> Q[重试/降级];
        Q --> R[返回错误];

    end

    classDef healthy fill:#f9f,stroke:#333,stroke-width:2px
    class C,E,F,M,N,O,J healthy