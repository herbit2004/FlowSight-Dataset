graph TD
    A[Order Received] --> B{Credit Card Valid?};
    B -- Yes --> C[Inventory Check];
    B -- No --> I[Notify Customer of Payment Failure];
    C --> D{Inventory Available?};
    D -- No --> E[Backorder Item];
