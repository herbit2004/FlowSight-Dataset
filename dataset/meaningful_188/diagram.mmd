graph TD
    subgraph 安全审计与漏洞修复流程
        A[开始] --> B{发起安全扫描请求};
        B -- 配置扫描策略 --> C[配置管理];
        C --> D[选择扫描目标];
        D --> E{目标资产存在？};
        E -- 是 --> F[启动扫描引擎];
        E -- 否 --> G[扫描结束: 无目标资产];
        F --> H[漏洞扫描模块];
        H --> I{发现漏洞？};
        I -- 是 --> J[漏洞报告生成];
        I -- 否 --> K[扫描结束: 未发现漏洞];
        J --> L[风险评估与优先级排序];

        subgraph 优先级处理流程
            L --> M{高危漏洞？};
            M -- 是 --> N[立即修复];
            M -- 否 --> O{中危漏洞？};
            O -- 是 --> P[安排修复];
            O -- 否 --> Q[低危/信息型漏洞];
            Q --> R[监控与观察];
            N --> S[验证修复结果];
            P --> S;
            R --> T[定期复查];
        end

        S --> U{修复成功？};
        U -- 是 --> V[漏洞状态更新];
        U -- 否 --> W[重新修复或缓解措施];
        V --> X[生成修复报告];
        W --> N;
        X --> Y[安全扫描结束];
        K --> Y;
        G --> Y;

        Y --> Z[安全知识库更新];
        Z --> AA[持续监控与改进];
        AA --> BB[定期安全培训];
        BB --> A;
        Y --> AB[风险管理平台同步];
        AB --> AA;
    end

    classDef highRisk fill:#fbb,stroke:#f00,stroke-width:2px;
    classDef mediumRisk fill:#fc8,stroke:#f93,stroke-width:1px;
    classDef lowRisk fill:#beb,stroke:#393,stroke-width:1px;
    classDef infoRisk fill:#ccf,stroke:#339,stroke-width:1px;

    class N highRisk;
    class P mediumRisk;
    class Q lowRisk;
    class R infoRisk;