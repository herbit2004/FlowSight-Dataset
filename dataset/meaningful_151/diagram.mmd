graph TD
    subgraph Resource Request & Approval Workflow
    A[开始: 资源申请] --> B{填写申请表单};
    B --> C{自动校验: 资源可用性};
    C -- 可用 --> D[提交申请];
    C -- 不可用 --> E[返回: 修改申请];
    E --> B;
    D --> F{路由审批: 审批人类型};
    F -- 直接主管 --> G[主管审批];
    F -- 安全部门 --> H[安全审批];
    F -- 财务部门 --> I[财务审批];

    G --> J{主管审批结果};
    H --> K{安全审批结果};
    I --> L{财务审批结果};

    J -- 同意 --> M[同步审批结果];
    J -- 拒绝 --> N[拒绝申请];
    K -- 同意 --> M;
    K -- 拒绝 --> N;
    L -- 同意 --> M;
    L -- 拒绝 --> N;

    M --> O{所有审批完成?};
    O -- 是 --> P[资源分配];
    O -- 否 --> M;

    P --> Q[通知申请人];
    Q --> R[资源启用];
    R --> S[结束: 资源使用];

    N --> AA[通知申请人];
    AA --> ZZ[结束: 申请被拒];

    classDef approved fill:#ccffcc,stroke:#333,stroke-width:2px;
    classDef rejected fill:#ffcccc,stroke:#333,stroke-width:2px;
    classDef pending fill:#ffffcc,stroke:#333,stroke-width:2px;

    class G,H,I pending;
    class J,K,L pending;
    end