graph TD
    A[用户请求] --> B(支付网关);
    B -- 支付成功 --> C{风控系统};
    B -- 支付失败 --> D[返回支付失败];
    C -- Yes --> E[消息队列];
    C -- No --> F[记录可疑交易];
    E --> G[订单服务];
    G --> H{写缓存};
    H -- Yes --> I[数据库];
    H -- No --> J[调用库存服务];
    I --> K[返回订单成功];
    J --> L{扣减库存};
    L -- 库存足够 --> M[返回库存成功];
    L -- 库存不足 --> N[返回库存不足];
    M --> O[更新数据库库存];
    O --> H;

    subgraph 登录流程
        P[用户注册] --> Q(认证服务);
        Q --> R{鉴权服务};
        R -- Yes --> S[生成Token];
        R -- No --> T[返回未授权];
        S --> Q;
        T --> U[返回登录失败];
    end

    subgraph 数据同步
        V[数据库变更] --> W[通知缓存服务];
        W --> X{读缓存};
        X -- Yes --> Y[更新数据库];
        X -- No --> Z[删除缓存];
        Z --> AA[返回同步成功];
    end

    subgraph API 调用
        AB[内部服务 A] --> AC(外部 API);
        AC --> AD{重试机制};
        AD -- Yes --> AE[返回 API 成功];
        AD -- No --> AF[返回 API 失败];
        AE --> AB;
    end