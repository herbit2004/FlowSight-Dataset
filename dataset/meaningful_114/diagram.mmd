graph TD
    subgraph 数据接入层
        A[实时数据流] --> B(数据清洗与转换);
        C[离线数据仓库] --> B;
    end

    B --> D{规则引擎核心};

    subgraph 规则引擎核心
        D --> E{决策预处理};
        E -- 命中预热规则 --> F[预热特征];
        E -- 未命中预热规则 --> G[实时特征计算];
        F --> H{规则匹配};
        G --> H;
        H -- 命中规则 --> I[风险决策];
        H -- 未命中规则 --> J[默认决策];
    end

    I --> K[策略执行层];
    J --> K;

    subgraph 策略执行层
       K --> L{{阻断/放行}};
    end

    L --> M[监控与报警];
    M --> N[规则优化反馈];
    N --> O(规则配置管理);
    O --> D;

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    classDef decision fill:#ccf,stroke:#333,stroke-width:2px
    class A,B,F,G,I,J,K,L,M,N,O process
    class D,E,H decision