graph TD
    subgraph 入库流程
        A[接收到入库请求] --> B{检查库存状态};
        B -- 库存小于阈值 --> C[启动补货流程];
        B -- 库存充足 --> D[分配入库库位];
        C --> D;
        D --> E[执行质检];
        E -- 质检通过 --> F[搬运至指定库位];
        E -- 质检不通过 --> G[隔离并通知质检部门];
        F --> H[更新库存信息];
    end

    subgraph 出库流程
        I[接收到出库请求] --> J[检查库存];
        J -- 库存充足 --> K[拣货];
        J -- 库存不足 --> L[通知缺货];
        K --> M[复核];
        M --> N[包装];
        N --> O[生成出库单];
        O --> P[通知物流];
    end

    H --> Q((流程结束));
    P --> Q;
    L --> Q;

    classDef finished fill:#f9f,stroke:#333,stroke-width:2px
    Q:::finished