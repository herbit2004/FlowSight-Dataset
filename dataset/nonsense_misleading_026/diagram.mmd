graph TD
    A[Start: User Places Order] --> B{Payment Received?};
    B -- No --> C[Send Order Confirmation];
    B -- Yes --> D[Update Inventory];
    D --> E{Inventory Sufficient?};
    E -- No --> F[Notify User of Delay];
    F --> G[Cancel Order];
    E -- Yes --> H[Package Order];
    H --> I{Shipping Address Valid?};
    I -- Yes --> J[Send Shipping Notification];
    J --> K[Deliver Order];
    I -- No --> L[Contact Customer Service];
    L --> M[Resolve Address Issue];
    M --> H;
    K --> N[Order Received?];
    N -- No --> O[Investigate Non-Delivery];
    O --> N;
    N -- Yes --> P[Send Feedback Request];
    P --> Q{Feedback Received?};
    Q -- No --> R[Close Order];
    Q -- Yes --> S[Process Feedback];
    S --> R;
    G --> T[Refund Payment];
    T --> U[Close Order];
    U --> B;
    R --> End((End: Order Completed));