graph TB
    %% 主要阶段
    A["S01<br/>需求边界确认"] 
    B["S02<br/>Spec规范制定"]
    
    %% S01 子任务
    A1["S01.1<br/>项目基础信息收集"]
    A2["S01.2<br/>模糊需求识别与标记"]
    
    %% S02 子任务
    B1["S02.1<br/>创建Spec目录结构"]
    B2["S02.2<br/>需求总览文档编写"]
    B3["S02.3<br/>功能需求详细定义"]
    B4["S02.4<br/>非功能需求定义"]
    B5["S02.5<br/>边界与异常处理"]
    B6["S02.6<br/>验收标准制定"]
    B7["S02.7<br/>需求澄清与迭代"]
    
    %% 质量检查
    QC1["QC01<br/>Spec质量检查"]
    
    %% 版本管理
    VM["VM01<br/>版本信息管理"]
    
    %% 主流程
    A --> B
    
    %% 子任务连接
    A --> A1
    A --> A2
    
    B --> B1
    B --> B2
    B --> B3
    B --> B4
    B --> B5
    B --> B6
    B --> B7
    
    %% 质量检查连接
    B7 --> QC1
    
    %% 版本管理连接
    B1 --> VM
    
    %% 样式定义
    classDef mainPhase fill:#4caf50,stroke:#2e7d32,stroke-width:3px,color:#fff,font-weight:bold
    classDef requirementTask fill:#81c784,stroke:#4caf50,stroke-width:2px,color:#fff
    classDef specTask fill:#9c27b0,stroke:#6a1b9a,stroke-width:2px,color:#fff
    classDef qualityCheck fill:#2e7d32,stroke:#1b5e20,stroke-width:3px,color:#fff,font-weight:bold
    classDef versionMgmt fill:#795548,stroke:#5d4037,stroke-width:3px,color:#fff,font-weight:bold
    
    class A,B mainPhase
    class A1,A2 requirementTask
    class B1,B2,B3,B4,B5,B6,B7 specTask
    class QC1 qualityCheck
    class VM versionMgmt