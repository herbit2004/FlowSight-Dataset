graph TD
    subgraph 数据源区
        DataGen[数据生成器];
        ExternalDB[外部数据库];
        MessageQueue[消息队列];
    end

    subgraph ETL处理区
        A[数据抽取];
        B[数据清洗];
        C{数据转换};
        D[数据验证];
        E[数据加载];
    end

    subgraph 数据仓库区
        StagingArea[临时存储区];
        DataWarehouse[数据仓库];
        DataMart[数据集市];
    end

    DataGen --> A;
    ExternalDB --> A;
    MessageQueue --> A;

    A --> B;
    B --> C;

    C -- 类型转换 --> D;
    C -- 格式转换 --> D;
    C -- 字段映射 --> D;

    D -- 验证通过 --> E;
    D -- 验证失败 --> F[错误处理];

    E --> StagingArea;
    StagingArea --> DataWarehouse;
    DataWarehouse --> DataMart;

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E process