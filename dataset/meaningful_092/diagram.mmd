graph TD
    subgraph 扫描流程
        A[发起安全扫描] --> B{配置扫描参数};
        B -- 参数正确 --> C[执行扫描];
        B -- 参数错误 --> D[返回错误报告];
        C --> E{发现漏洞?};
        E -- 是 --> F[记录漏洞信息];
        E -- 否 --> G[扫描完成];
        F --> H[提交漏洞报告];
        H --> G;
    end

    subgraph 修复流程
        G --> I[漏洞报告审核];
        I -- 通过 --> J[分配修复任务];
        I -- 驳回 --> K[重新扫描验证];
        J --> L[开发修复漏洞];
        L --> M[测试修复结果];
        M -- 修复成功 --> N[合并代码];
        M -- 修复失败 --> L;
        N --> O[部署上线];
    end

    classDef completed fill:#f9f,stroke:#333,stroke-width:2px;
    O:::completed