graph TD
    subgraph 初始状态
        A[账单触发事件];
    end

    A --> B{是否批量生成?};

    subgraph 批量处理
        B -- 是 --> C[采集批量生成参数];
        C --> D[任务调度系统];
        D --> E(创建批量生成任务);
        E --> F{任务执行成功?};
        F -- 是 --> G[更新任务状态];
        F -- 否 --> H[记录错误日志];
        G --> I((汇总结果通知));
        H --> I;
    end

    subgraph 单笔处理
        B -- 否 --> J[数据预处理];
        J --> K[调用计费引擎];
        K --> L{计费成功?};
        L -- 是 --> M[生成账单数据];
        L -- 否 --> N[记录计费失败日志];
        M --> O[账单持久化];
        N --> O;
        O --> P((生成结果通知));
    end


    I --> Q((最终结果通知));
    P --> Q;

    subgraph 结束状态
        Q[账单生成结束];
    end

    classDef endfill fill:#f9f,stroke:#333,stroke-width:2px
    class A,Q endfill