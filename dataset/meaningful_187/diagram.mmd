graph TD
    subgraph 用户端
        A[用户请求兑换] --> B(积分校验);
    end

    B --> C{积分足够?};
    C -- 是 --> D(锁定用户积分);
    C -- 否 --> E[提示积分不足];

    D --> F(生成兑换订单);
    F --> G(提交订单至兑换服务);

    subgraph 兑换服务
        G --> H(订单状态:待处理);
        H --> I{奖品库存足够?};
        I -- 是 --> J(扣减库存);
        I -- 否 --> K[订单状态:库存不足，通知用户];
        K --> L(释放用户积分);

        J --> M(调用物流服务);

        subgraph 物流服务
            M --> N(创建物流订单);
            N --> O{物流订单创建成功?};
            O -- 是 --> P(更新物流状态);
            O -- 否 --> Q[订单状态:物流异常，人工介入];
        end

        P --> R(更新兑换订单状态:已发货);
        R --> S(推送发货通知);
    end

    S --> T[用户收到奖品];

    T --> U{用户确认收货?};
    U -- 是 --> V(更新订单状态:已完成);
    U -- 否 --> W[用户未确认收货];

    V --> X(释放锁定积分);

    W --> Y{超过自动确认时间?};
    Y -- 是 --> Z(自动确认收货);
    Y -- 否 --> W;

    Z --> V;

    E --> AA[返回兑换失败信息];
    Q --> BB[更新订单状态:物流异常];
    BB --> L;

    classDef online fill:#f9f,stroke:#333,stroke-width:2px
    class A,T online
    classDef error fill:#fbb,stroke:#f00,stroke-width:2px
    class K,Q error
    classDef success fill:#ccf,stroke:#333,stroke-width:2px
    class V,X success