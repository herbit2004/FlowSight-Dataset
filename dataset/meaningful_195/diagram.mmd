graph TD
    subgraph 库存扣减与回滚流程
    A[请求到达: 订单服务];
    B[检查库存是否充足];
    C{库存充足？};
    D[尝试扣减库存: 库存服务];
    E{扣减成功？};
    F[生成预扣减记录: Redis];
    G[发送消息: 扣减成功事件];
    H[订单服务: 继续后续流程];
    I[库存不足: 返回错误];
    J[业务异常: 订单取消/支付失败];
    K[监听取消订单事件];
    L[查询预扣减记录: Redis];
    M{存在预扣减记录？};
    N[回滚库存: 库存服务];
    O[删除预扣减记录: Redis];
    P[回滚成功: 发送回滚成功事件];
    Q[系统异常: 人工介入];
    R[订单服务: 关闭订单];
    S[通知用户];
    end

    A --> B;
    B --> C;
    C -- 是 --> D;
    C -- 否 --> I;
    D --> E;
    E -- 是 --> F;
    E -- 否 --> J;
    F --> G;
    G --> H;
    I --> R;
    J --> K;
    K --> L;
    L --> M;
    M -- 是 --> N;
    M -- 否 --> Q;
    N --> O;
    O --> P;
    R --> S;

    style Q fill:#f9f,stroke:#333,stroke-width:2px