graph TD
    subgraph 订单与生产
        A[订单系统] --> B{生产计划};
        B --> C[生产线];
        C --> D[产出批次];
    end

    subgraph 质检流程
        D --> E{质检请求};
        E --> F[初检：外观、尺寸];
        F -- 合格 --> G{是否抽检};
        F -- 不合格 --> H[不合格品处理];
        G -- 是 --> I[抽样];
        G -- 否 --> J[良品入库];
        I --> K[抽样送检];
        K --> L{复检：性能测试};
        L -- 合格 --> J;
        L -- 不合格 --> M[扩大抽检范围];
        M --> N[深度分析];
        N --> O[问题定位];
        O --> P{是否可修复};
        P -- 是 --> Q[返工修复];
        P -- 否 --> H;
        Q --> R[修复后复检];
        R -- 合格 --> J;
        R -- 不合格 --> H;
    end

    subgraph 数据与报告
        J --> S[良品数据];
        H --> T[不良品数据];
        S & T --> U[质检报告];
        U --> V[质量分析];
    end
   
    classDef normal fill:#f9f,stroke:#333,stroke-width:2px
    classDef important fill:#ccf,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,I,K,L,M,N,O,P,Q,R,S,T,U,V normal
    class H important