graph TD
    A[用户查询] --> B{查询预处理};
    B --> C[意图识别];
    C --> D{意图: 知识检索?};
    D -- 是 --> E[查询扩展与改写];
    D -- 否 --> F[其他业务流程];
    E --> G[构建检索向量];
    G --> H[向量数据库查询];
    H --> I{找到相关知识?};
    I -- 是 --> J[知识片段抽取];
    I -- 否 --> K[降低检索阈值];
    K --> H;
    J --> L[答案生成];
    L --> M[优化答案];
    M --> N[答案后处理];
    N --> O[返回答案给用户];
    F --> P[执行其他流程];
    P --> O;
    classDef blue fill:#f9f,stroke:#333,stroke-width:2px;
    class A,E,G,H,J,L,M,N blue