graph TD
    A[User Places Order] --> B{Payment Received?};
    B -- No --> C[Send Payment Reminder];
    C --> D{Payment Received?};
    D -- No --> E[Cancel Order - Refund Payment];
    D -- Yes --> F[Order Processing Started];
    B -- Yes --> F;
    F --> G[Inventory Check];
    G -- Not Available --> H[Notify Customer of Delay];
    H --> I[Issue Partial Refund for Unavailable Items];
    I --> J[Ship Remaining Items];
    G -- Available --> K[Allocate Inventory];
    K --> L[Packaging];
    L --> J;
    J --> M[Order Shipped];
    M --> N{Customer Received Order?};
    N -- Yes --> O[Close Order];
    N -- No --> P[Investigate Delivery Issue];
    P --> Q{Delivery Issue Resolved?};
    Q -- Yes --> M;
    Q -- No --> R[Issue Full Refund];
    R --> S[Archive Order Data];
    O --> S;
    S --> T[Generate Sales Report];
    T --> U[Stock Replenishment Triggered];
    U --> V[Contact Supplier];
    V --> W[Receive Restock];
    W --> AA[Update Inventory Levels];
    AA --> BB[End];
    E --> BB;
    R --> BB;
    AA --> BB;