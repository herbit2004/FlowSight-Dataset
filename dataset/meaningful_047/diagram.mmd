graph TD
    A[原始数据源] --> B{数据类型识别};
    B -- 敏感数据 --> C[脱敏规则引擎];
    B -- 非敏感数据 --> D[直接写入目标];
    C --> E{规则匹配};
    E -- 匹配成功 --> F[脱敏处理函数];
    E -- 匹配失败 --> D;
    F --> G[加密算法选择]:::styleClass;
    G --> H[数据加密];
    H --> I[密钥管理服务];
    I --> J{密钥获取成功};
    J -- YES --> K[加密数据存储];
    J -- NO --> L[告警];
    K --> D;
    D --> M[目标数据存储];

    classDef styleClass fill:#f9f,stroke:#333,stroke-width:2px