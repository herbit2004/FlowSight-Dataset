graph TD
    subgraph Data Masking and Encryption Flow
    A[Incoming Data Feed] --> B{Is PII Present?};
    B -- Yes --> C[PII Identification Module];
    B -- No --> F[Data Storage];
    C --> D{Masking/Encryption Rule Engine};
    D -- Apply Masking --> E[Data Masking Module];
    D -- Apply Encryption --> G[Data Encryption Module];
    E --> F;
    G --> F;
    F[Data Storage];
    end