graph TD
    A[消息发布者];
    B[消息路由服务];
    C{消息过滤规则};
    D[持久化队列];
    E[订阅者A];
    F[订阅者B];
    G[监控告警系统];

    A --> B;
    B -- "符合规则" --> C;
    C -- "规则匹配" --> D;
    D --> E;
    D --> F;
    B -- "异常消息" --> G;

    classDef default fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G default