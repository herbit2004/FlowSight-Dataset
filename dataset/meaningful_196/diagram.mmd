graph TD
    subgraph 消息队列系统
        A[消息生产者客户端] --> B(消息负载均衡器)
        B --> C{消息队列集群};
        C -- Topic A --> D[消息存储节点 A1];
        C -- Topic A --> E[消息存储节点 A2];
        C -- Topic B --> F[消息存储节点 B1];
        C -- Topic B --> G[消息存储节点 B2];
    end

    subgraph 订单服务
        H[订单服务实例 1] --> I[数据缓存]
        H --> J[订单数据库]
        I -- 数据更新事件 --> K(消息生产者: Topic A);
        J -- 订单状态变更 --> L(消息生产者: Topic B);
    end

    subgraph 库存服务
        M[库存服务实例 1] --> N[库存数据库]
        M --> O(消息消费者: Topic A);
        O --> P{数据校验};
        P -- 校验通过 --> Q[更新库存];
        P -- 校验失败 --> R[补偿处理];
        Q --> N;
        R --> S[告警系统];
    end

    subgraph 物流服务
        T[物流服务实例 1] --> U(消息消费者: Topic B);
        U --> V[创建物流记录];
        V --> W[更新物流状态];
        W --> X[物流数据库];
    end

    subgraph 用户服务
        Y[用户服务实例 1]
        Y --> Z(消息消费者: Topic B);
        Z --> AA[发送通知]
        AA --> AB[用户通知系统]
    end

    K --> B
    L --> B

    classDef service fill:#f9f,stroke:#333,stroke-width:2px
    class H,M,T,Y service
    classDef database fill:#ccf,stroke:#333,stroke-width:2px
    class J,N,X database
    classDef queue fill:#ffc,stroke:#333,stroke-width:2px
    class B,C queue
    classDef process fill:#eee,stroke:#333,stroke-width:2px
    class O,P,Q,R,U,V,W,Z process