graph TD
    subgraph 用户请求处理
        A[用户请求] --> B{入口网关};
        B --> C{流量整形};
        C --> D{令牌桶算法};
        D -- 有令牌 --> E{配额管理器};
        D -- 无令牌 --> H[限流响应];
        E -- 允许 --> F{下游服务};
        E -- 超配额 --> I[熔断器];
        I -- 熔断态 --> J[快速失败];
        I -- 半开态 --> K{尝试请求};
        K -- 成功 --> L[恢复服务];
        K -- 失败 --> J[快速失败];
        F --> G[服务响应];
        G --> B;
        H --> B;
        J --> B;
        L --> I;
    end

    style B fill:#f9f,stroke:#333,stroke-width:2px
    classDef myClass fill:#ccf,stroke:#333,stroke-width:2px
    class C,D,E,F,I,K myClass