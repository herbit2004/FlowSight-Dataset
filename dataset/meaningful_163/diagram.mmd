graph TD
    subgraph 结算系统工作流
    A[订单创建] --> B{风控检查};
    B -- 通过 --> C[预支付];
    B -- 驳回 --> H[订单取消];

    C --> D{预支付结果};
    D -- 成功 --> E[扣款];
    D -- 失败 --> F[预支付失败处理];
    F --> H;

    E --> G{扣款结果};
    G -- 成功 --> I[结算];
    G -- 失败 --> J[退款];
    J --> K[退款成功通知];

    I --> L[结算完成];
    L --> M[工作流结束];
    K --> M;
    H --> M;

    classDef pass fill:#90EE90,stroke:#333,stroke-width:2px;
    classDef reject fill:#F08080,stroke:#333,stroke-width:2px;
    class B,D,G pass
    class F,J reject

    end