graph TD
    subgraph 库存扣减流程
        A[用户请求] --> B{校验请求参数};
        B -- 参数有效 --> C[预占库存];
        C -- 预占成功 --> D[生成待扣减记录];
        C -- 预占失败 --> E[返回库存不足];
        D --> F[发送库存扣减消息];
        F --> G{MQ: 库存扣减消费者};
        G -- 收到消息 --> H[实际扣减库存];
        H -- 扣减成功 --> I[更新扣减记录状态为成功];
        H -- 扣减失败 --> J[更新扣减记录状态为失败];
        I --> K[释放预占库存];
        J --> K;
        K --> L[流程结束: 库存已扣减/预占已释放];
        B -- 参数无效 --> M[返回参数错误];
        M --> L;
        E --> L;
    end

    subgraph 库存回滚流程
        N[接收回滚请求];
        N --> O{查询待扣减记录状态};
        O -- 状态为失败 --> P[释放预占库存];
        O -- 其他状态 --> Q[记录状态异常];
        P --> R[更新扣减记录状态为已回滚];
        R --> S[流程结束: 库存已回滚];
        Q --> S;
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style N fill:#f9f,stroke:#333,stroke-width:2px