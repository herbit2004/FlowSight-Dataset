graph TD
    A[用户问题输入] --> B{意图识别与槽位填充};
    B -- 意图明确 --> C[知识库检索];
    B -- 意图不明确 --> D[多轮对话引导];
    C --> E{找到答案？};
    E -- Yes --> F[答案组织与呈现];
    E -- No --> G[转人工客服];
    D --> H[用户进一步提问];
    H --> B;
    F --> I[用户满意度评价];
    I -- 满意 --> J[结束对话];
    I -- 不满意 --> G;
    G --> K[人工客服介入];
    K --> L[问题解决];
    L --> J;
    classDef green fill:#90EE90,stroke:#333,stroke-width:2px;
    class A,C,F,I,L green;
    style G fill:#FF7F50,stroke:#333,stroke-width:2px;
    style B,E,D fill:#ADD8E6,stroke:#333,stroke-width:2px;
    J --> M[记录并分析对话数据];