graph TD
    subgraph Single Sign-On with 会话协商
    A[用户访问应用];
    B[检测本地会话];
    C{有本地会话?};
    D[验证会话有效性];
    E{会话有效?};
    F[应用授权验证];
    G[生成应用会话];
    H[返回应用页面];
    I[发起 SSO 认证请求];
    J[SSO 认证中心];
    K[创建/更新 SSO 会话];

    A --> B;
    B --> C;
    C -- 是 --> D;
    D --> E;
    E -- 是 --> F;
    F --> G;
    G --> H;
    E -- 否 --> I;
    C -- 否 --> I;
    I --> J;
    J --> K;
    K --> F;
    end