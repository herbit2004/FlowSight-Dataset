graph TD
    A[用户请求] --> B(数据库);
    B --> C{数据存在?};
    C -- Yes --> D[返回数据给用户];
    C -- No --> E[调用外部API];
    E --> F(写缓存);
    F --> G{支付成功?};
    G -- Yes --> H[发送消息到队列];
    G -- No --> I[返回错误给用户];
    H --> J[网关];
    J --> K(认证);
    K --> L{权限足够?};
    L -- Yes --> M[继续处理请求];
    L -- No --> N[返回权限错误];
    M --> O[日志记录];
    O --> P(鉴权);
    P --> A;  
    I --> Q[风控系统];
    Q --> I;
    D --> R(用户余额);
    R --> D;