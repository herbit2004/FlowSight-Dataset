graph TD
    A[User Places Order] --> B{Payment Received?};
    B -- No --> C[Send Order Confirmation];
    B -- Yes --> D[Inventory Check];
    D -- Available --> E[Package Order];
    D -- Unavailable --> F[Notify Customer];
    F --> A;
    E --> G{Shipping Address Valid?};
    G -- No --> H[Order Shipped];
    G -- Yes --> I[Refund Payment];
    I --> A;
    H --> J[Send Tracking Number];
    J --> K[Order Delivered];
    K --> L[Marked as Complete];
    L --> B;