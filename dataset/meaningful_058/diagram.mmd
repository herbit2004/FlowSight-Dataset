graph TD
    subgraph 系统初始化
        A[启动服务];
        B[加载密钥库];
        C{主密钥是否可用?};
    end

    A --> B;
    B --> C;
    C -- 是 --> D[使用主密钥解密应用密钥];
    C -- 否 --> E[生成新主密钥];
    E --> F[加密应用密钥];
    F --> G[持久化新主密钥和加密的应用密钥];
    G --> D;

    D --> H[应用启动完成];

    subgraph 周期性密钥轮换
        H -- 定时任务触发 --> I[生成新的应用密钥];
        I --> J[使用主密钥加密新应用密钥];
        J --> K[更新密钥库中加密后的应用密钥];
        K --> L[通知各模块更新密钥];
    end