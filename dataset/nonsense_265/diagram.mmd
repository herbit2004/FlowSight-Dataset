graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户存在?};
    C -- Yes --> D[读取用户信息];
    C -- No --> E[创建用户];
    E --> B;
    D --> F(支付网关);
    F --> G{支付成功?};
    G -- Yes --> H[发送欢迎邮件];
    G -- No --> I[显示支付失败];
    I --> A;
    H --> J(缓存);
    J --> K{缓存命中?};
    K -- Yes --> L[返回响应];
    K -- No --> M[更新用户信息];
    M --> J;
    L --> A;
    A --> N[负载均衡];
    N --> O(API 网关);
    O --> P[认证];
    P --> Q{认证成功?};
    Q -- Yes --> R[鉴权];
    Q -- No --> S[返回 401];
    R --> T[写入日志];
    T --> U[消息队列];
    U --> V(数据分析服务);
    S --> A;
    V --> A;
    R --> W[限流];
    W --> X{超过阈值?};
    X -- Yes --> Y[返回 429];
    X -- No --> Z[处理请求];
    Z --> A;
    Y --> A;