graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户已登录?};
    C -- Yes --> D[更新缓存];
    C -- No --> E[登录];
    E --> F[调用支付API];
    F --> G(网关);
    G --> H{权限校验通过?};
    H -- Yes --> B;
    H -- No --> I[返回错误];
    I --> A;
    D --> J[发送消息到消息队列];
    J --> K(用户);
    K --> L[读缓存];
    L --> A;
    G --> M[用户画像服务];
    M --> G;