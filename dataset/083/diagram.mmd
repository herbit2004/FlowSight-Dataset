graph LR
    subgraph "Kubernetes Cluster"
        K8s[Kubernetes Pods<br/>with Cilium]
        Cilium[Cilium<br/>eBPF Dataplane]
        HubbleObs[Hubble<br/>Observability]
    end
    
    subgraph "PolicyPilot"
        CLI2[CLI Tool]
