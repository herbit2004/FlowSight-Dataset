graph TD
    subgraph 合同发起
        A[发起人填写合同信息];
        B[系统校验合同数据];
        C{数据校验通过？};
        D[生成合同编号];
    end
    subgraph 合同审批
        E[提交审批];
        F{审批流程};
        G[审批人审批];
        H{审批结果？};
    end
    subgraph 合同签署
        I[合同草案生成];
        J[签署方一确认];
        K{签署方一确认结果？};
        L[签署方二确认];
        M{签署方二确认结果？};
        N[盖章/签名];
        O[生成电子合同];
    end
    subgraph 合同归档及生效
        P[合同归档];
        Q[合同生效];
        R[通知相关方];
        S[系统记录合同信息];
    end

    A --> B;
    B --> C;
    C -- 是 --> D;
    C -- 否 --> A;
    D --> E;
    E --> F;
    F --> G;
    G --> H;
    H -- 通过 --> I;
    H -- 驳回 --> A;

    I --> J;
    J --> K;
    K -- 确认 --> L;
    K -- 拒绝 --> A;
    L --> M;
    M -- 确认 --> N;
    M -- 拒绝 --> A;
    N --> O;
    O --> P;
    P --> Q;
    Q --> R;
    R --> S;

    classDef success fill:#90EE90,stroke:#333,stroke-width:2px;
    class D,O,P,Q success;