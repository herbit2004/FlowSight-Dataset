graph TD
    subgraph 揽收流程
    A[揽收点接收包裹] --> B{扫描包裹条码};
    B -- 条码有效 --> C[上传揽收信息];
    B -- 条码无效 --> BA[包裹信息异常];
    C --> D[更新包裹状态为“已揽收”];
    D --> E(生成揽收任务);
    E --> F[分拣中心接收任务];
    end

    subgraph 干线运输
    F --> G{计算最优路线};
    G -- 有可用路线 --> H[分配运输车辆];
    G -- 无可用路线 --> GA[延迟运输];
    H --> I[车辆装载包裹];
    I --> J[干线运输至下一分拣中心];
    end

    subgraph 末端配送
    J --> K[更新包裹状态为“运输中”];
    K --> L[到达末端配送站点];
    L --> M{智能调度派送员};
    M -- 派送员已分配 --> N[派送员接收任务];
    M -- 派送员未分配 --> MA[人工分配派送员];
    N --> O[派送员开始派送];
    O --> P{客户签收};
    P -- 签收成功 --> Q[上传签收凭证];
    P -- 签收失败 --> PA[重新派送];
    Q --> R[更新包裹状态为“已签收”];
    end

    R --> S(结束);

    classDef success fill:#ccffcc,stroke:#333,stroke-width:2px;
    class R,S success