graph TD
    subgraph MembershipTierSystem
    A[User Request: Access Membership Benefits];
    B{Check User Authentication};
    C{Check Membership Status & Tier};
    D{Determine Entitlements Based on Tier};
    E[Tier: Bronze];
    F[Tier: Silver];
    G[Tier: Gold];
    H[Tier: Platinum];
    I{Apply Bronze Benefits};
    J{Apply Silver Benefits};
    K{Apply Gold Benefits};
    L{Apply Platinum Benefits};
    M[Grant Access to Core Features];
    N[Offer Discounted Merchandise];
    O[Provide Priority Support];
    P[Exclusive Content Access];
    Q[Deliver Personalized Recommendations];
    end

    A --> B
    B -- Authenticated --> C
    B -- Not Authenticated --> Denied[Access Denied];
    C -- Bronze --> E
    C -- Silver --> F
    C -- Gold --> G
    C -- Platinum --> H
    C -- No Membership --> Denied
    E --> I
    F --> J
    G --> K
    H --> L
    I --> M
    I --> N
    J --> M
    J --> N
    J --> O
    K --> M
    K --> N
    K --> O
    K --> P
    L --> M
    L --> N
    L --> O
    L --> P
    L --> Q
    M --> Complete[Access Granted];
    N --> Complete
    O --> Complete
    P --> Complete
    Q --> Complete

    classDef tierStyle fill:#f9f,stroke:#333,stroke-width:2px
    class E,F,G,H tierStyle