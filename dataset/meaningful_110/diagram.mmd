graph TD
    subgraph 工作流引擎
        A[提交申请] --> B{审批人};
        B -- 同意 --> C[风险评估];
        B -- 拒绝 --> I[结束: 驳回];
        C -- 低于阈值 --> D[自动批准];
        C -- 高于阈值 --> E[高级审批];
        D --> F[生成报告];
        E -- 同意 --> F;
        E -- 拒绝 --> I;
        F --> G[同步数据];
        G --> H[更新状态];
        H --> I[结束: 完成];
    end

    subgraph 通知服务
        J[发送通知] --> K{接收方};
        K -- 收到 --> L[已读];
        K -- 未收到 --> M[重试通知];
        M --> J;
    end

    A --> J;
    F --> J;
    I --> J;

    classDef passed fill:#afa,stroke:#333,stroke-width:2px;
    class C,D passed