graph TD
    A[用户请求] --> B(数据库写入);
    B --> C{用户已登录？};
    C -- Yes --> D[API 网关];
    C -- No --> E[登录];
    E --> F(读缓存);
    F --> G{登录成功？};
    G -- Yes --> D;
    G -- No --> H[返回登录失败];
    D --> I[认证];
    I --> J[鉴权];
    J --> K(消息队列);
    K --> L{支付成功？};
    L -- Yes --> M[更新订单状态];
    L -- No --> N[取消订单];
    N --> O(写缓存);
    O --> P[返回支付失败];
    M --> Q(支付服务);
    Q --> R[发送通知];
    R --> S[数据库读取];
    S --> A;
    I --> T(用户服务);
    T --> U[发送短信验证码];
    U --> V[风控系统];
    V --> W[返回数据];
    W --> X[用户响应];
    D --> X;
    P --> X;
    Q --> X;