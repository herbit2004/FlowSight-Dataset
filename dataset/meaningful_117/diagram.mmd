graph TD
    subgraph 定时任务调度系统
        A[任务定义配置] --> B(任务元数据存储);
        B --> C{任务状态检查};
        C -- 就绪 --> D[任务分发器];
        C -- 暂停/停止 --> E[状态监控告警];
        D --> F[工作节点池];
        F -->|获取任务| G(任务执行器);
        G --> H{执行结果判断};
        H -- 成功 --> I[结果回调];
        H -- 失败 --> J[失败重试策略];
        J --> K{是否超过最大重试次数};
        K -- 是 --> L[告警通知];
        K -- 否 --> M(延时队列);
        M --> C;
        I --> N[状态更新];
        L --> E;
        N --> B;
        E --> O[监控面板];
        subgraph 任务执行器内部
            G -- 下载依赖 --> G1[依赖管理];
            G -- 执行主逻辑 --> G2[业务处理器];
            G -- 上传结果 --> G3[结果暂存];
            G1 --> G2;
            G2 --> G3;
        end
        G -- 执行完成 --> H;
    end

    classDef taskNode fill:#f9f,stroke:#333,stroke-width:2px;
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O taskNode
    classDef processorNode fill:#ccf,stroke:#333,stroke-width:2px;
    class G1,G2,G3 processorNode