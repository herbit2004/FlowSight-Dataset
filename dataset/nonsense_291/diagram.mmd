graph TD
    A[用户请求] --> B(支付网关);
    B -- 余额充足? --> C{是};
    B -- 余额不足? --> D[错误页面];
    C --> E[消息队列];
    E --> F(订单服务);
    F --> G{读数据库};
    G -- 数据存在? --> H[写缓存];
    G -- 数据不存在? --> I[创建订单];
    I --> G
    H --> J[通知用户];
    J --> K{读缓存};
    K -- 缓存命中? --> L[发送邮件];
    K -- 缓存未命中? --> M[订单完成];
    L --> K
    M --> A