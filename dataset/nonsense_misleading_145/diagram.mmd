graph TD
    A[User Submits Order] --> B{Payment Received?};
    B -- Yes --> C[Order Confirmation Sent];
    C --> D[Item Picked & Packed];
    B -- No --> H[Cancel Order];
    D --> E{Shipping Address Valid?};
    E -- No --> I[Package Shipped];
    E -- Yes --> F[Notify User of Delay];
    F --> G[Resolve Address Issue];
    G --> D;
    I --> J[Order Delivered];
    J --> K[Process Refund];
    H --> K;
    K --> A;