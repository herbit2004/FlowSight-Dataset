graph TD
    subgraph PaymentService
        A[发起支付请求] --> B{检查账户余额足够?};
        B -- 是 --> C[扣减账户余额];
        B -- 否 --> Z[支付失败: 余额不足];
        C --> D[记录支付流水];
    end

    subgraph InventoryService
        D --> E[预占库存];
        E --> F{库存预占成功?};
        F -- 是 --> G[锁定库存];
        F -- 否 --> H[库存不足];
    end

    subgraph OrderService
        G --> I[创建订单];
    end

    I --> J{订单创建成功?};
    J -- 是 --> K[事务提交];
    J -- 否 --> L[订单创建失败];

    K --> M[发送成功消息];

    subgraph Compensation
        H --> N[尝试回滚库存预占];
        L --> O[尝试回滚订单创建];
        O --> P[通知PaymentService回滚支付];
        P --> Q[PaymentService: 增加账户余额];
        Q --> R[记录补偿流水];
        R --> S[补偿完成];
        N --> S;
    end

    classDef success fill:#afa,stroke:#333,stroke-width:2px;
    class K,M success;