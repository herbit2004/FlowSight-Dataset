graph TD
    A[用户请求] --> B(数据库)
    B --> C{用户已登录?}
    C -- Yes --> D[支付网关]
    C -- No --> E[登录]
    E --> F(认证服务)
    F --> G[鉴权服务]
    G --> E
    D --> H(消息队列)
    H --> I[订单服务]
    I --> J{库存充足?}
    J -- Yes --> K[扣减库存]
    K --> L(读缓存)
    L --> M[发送支付成功通知]
    J -- No --> N[退款]
    N --> D
    M --> O[更新订单状态]
    O --> B
    B --> A
    style A fill:#f9f,stroke:#333,stroke-width:2px
