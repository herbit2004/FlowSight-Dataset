graph TD
    A[User Places Order] --> B{Payment Received?};
    B -- No --> C[Send Order Confirmation];
    B -- Yes --> D[Inventory Check];
    D -- Available --> E[Shipping Preparation];
    E --> F[Package Order];
    F --> G{Address Valid?};
    G -- No --> H[Order Shipped];
    G -- Yes --> I[Generate Shipping Label];
    I --> J[Notify User of Delay];
    J --> K[Return to Inventory Check];
    K --> L{Inventory Available?};
    L -- Yes --> M[Packaging Complete];
    M --> N[Send Shipping Notification];
    N --> O[Order Delivered];
    O --> P[Close Order];
    L -- No --> Q[Refund Payment];
    Q --> P;
    H --> O;