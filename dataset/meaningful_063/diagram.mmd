graph TD
    subgraph 归档与清理流程
    A[开始: 策略触发或定时任务] --> B{数据类型判断};

    B -- 大数据分析数据 --> C1[大数据归档模块];
    B -- 操作日志数据 --> C2[日志归档模块];
    B -- 用户画像数据 --> C3[用户画像归档模块];
    B -- 交易数据 --> C4[交易数据归档模块];

    C1 --> D1{检查大数据存储容量};
    C2 --> D2{检查日志存储容量};
    C3 --> D3{检查用户画像存储容量};
    C4 --> D4{检查交易数据存储容量};

    D1 -- 容量充足 --> E1[大数据数据压缩];
    D2 -- 容量充足 --> E2[日志数据压缩];
    D3 -- 容量充足 --> E3[用户画像数据压缩];
    D4 -- 容量充足 --> E4[交易数据压缩];

    D1 -- 容量不足 --> F1[执行大数据清理策略];
    D2 -- 容量不足 --> F2[执行日志清理策略];
    D3 -- 容量不足 --> F3[执行用户画像清理策略];
    D4 -- 容量不足 --> F4[执行交易数据清理策略];

    E1 --> G1[大数据数据加密];
    E2 --> G2[日志数据加密];
    E3 --> G3[用户画像数据加密];
    E4 --> G4[交易数据加密];

    F1 --> H1[删除过期大数据数据];
    F2 --> H2[删除过期日志数据];
    F3 --> H3[删除过期用户画像数据];
    F4 --> H4[删除过期交易数据];

    G1 --> I1[大数据数据归档至冷存储];
    G2 --> I2[日志数据归档至冷存储];
    G3 --> I3[用户画像数据归档至冷存储];
    G4 --> I4[交易数据归档至冷存储];

    H1 --> I1;
    H2 --> I2;
    H3 --> I3;
    H4 --> I4;

    I1 --> J[更新大数据元数据];
    I2 --> J;
    I3 --> J;
    I4 --> J;

    J --> K[记录归档/清理日志];
    K --> L[发送归档/清理通知];
    L --> M[结束: 流程完成];
    end

    classDef process fill:#f9f,stroke:#333,stroke-width:2px;
    classDef decision fill:#ccf,stroke:#333,stroke-width:2px;
    class A,M process;
    class B,D1,D2,D3,D4 decision;
    class C1,C2,C3,C4,E1,E2,E3,E4,F1,F2,F3,F4,G1,G2,G3,G4,H1,H2,H3,H4,I1,I2,I3,I4,J,K,L process;