graph TD
    subgraph 服务A - 订单服务
        A[接收订单创建请求];
        B[验证订单信息];
        C[请求库存服务];
    end

    subgraph 服务B - 库存服务
        D[接收库存扣减请求];
        E[检查库存];
        F{库存充足？};
        G[扣减库存];
        H[返回扣减结果];
    end

    A --> B;
    B --> C;
    C -- gRPC --> D;
    D --> E;
    E --> F;
    F -- 是 --> G;
    G --> H;
    F -- 否 --> I[返回库存不足];
    I --> C;
    H --> B;
    B --> J[订单创建成功];

    classDef success fill:#afa,stroke:#333,stroke-width:2px;
    class J success;