graph TD
    A[用户请求] --> B(数据库);
    B --> C{是否已登录};
    C -- Yes --> D[读缓存];
    C -- No --> E[登录];
    E --> F(API 网关);
    F --> G{支付成功};
    G -- Yes --> H[写缓存];
    G -- No --> E;
    H --> I[消息队列];
    I --> J(认证);
    J --> K[返回响应];
    D --> L{数据有效};
    L -- Yes --> K;
    L -- No --> M[更新数据库];
    M --> D;
    K --> A;