graph TD
    A[用户请求] --> B(数据库写入);
    B --> C{用户已登录?};
    C -- Yes --> D[读缓存];
    C -- No --> E[登录];
    E --> F(写缓存);
    F --> C;
    D --> G{权限校验?};
    G -- No --> H[返回 403];
    G -- Yes --> I[API 网关];
    I --> J(支付);
    J --> K[消息队列];
    K --> L{支付成功?};
    L -- Yes --> M[数据库读取];
    L -- No --> J;
    M --> N[生成响应];
    N --> A;
    I --> O[退款服务];
    O --> I;
    style A fill:#f9f,stroke:#333,stroke-width:2px