graph TD
    A[User Initiates Incident Report] --> B{Severity Level?};
    B -- High --> C[Automated Alert System Triggered];
    B -- Medium --> D[Incident Assigned to First Available Responder];
    B -- Low --> E[Incident Placed in Backlog];
    C --> F{SLA Breach Imminent?};
    F -- Yes --> H[Escalate to Incident Manager];
    F -- No --> D;
    D --> G{Resolution Possible?};
    G -- No --> I[Incident Closure];
    G -- Yes --> J[Implement Fix];
    J --> K{Fix Successful?};
    K -- Yes --> L[Verify Resolution];
    K -- No --> D;
    L --> M{Verification Passed?};
    M -- No --> J;
    M -- Yes --> I;
    E --> N[Periodic Review];
    N --> O{Resolution Possible?};
    O -- Yes --> J;
    O -- No --> P[Incident Marked as Resolved];
    P --> Q[Document Incident Details];
    Q --> I;
    H --> R[Incident Commander Activated];
    R --> S[Resource Mobilization];
    S --> T[Coordinate Response Efforts];
    T --> U{Resolution Achieved?};
    U -- Yes --> L;
    U -- No --> S;
    I --> V[Incident Metrics Analyzed];
    V --> W[Communicate Resolution to User];
    W --> X{User Confirms Resolution?};
    X -- No --> A;
    X -- Yes --> Y[Incident Closed in System];