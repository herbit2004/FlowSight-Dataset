graph TD
    subgraph 用户端
        A[用户发起订单] --> B{检查库存};
    end

    B -- 库存充足 --> C[生成预订单];
    B -- 库存不足 --> B1[提示库存不足];

    C --> D[风控校验];
    D -- 通过 --> E[锁定库存];
    D -- 未通过 --> D1[订单风控拦截];

    E --> F{用户选择支付方式};
    F --> G[调用支付渠道];
    G --> H{支付渠道处理};
    H -- 支付成功 --> I[支付结果回调];
    H -- 支付失败 --> G1[支付失败处理];

    I --> J[更新订单状态为“已支付”];
    J --> K[推送消息通知];

    subgraph 后端服务
        style A fill:#f9f,stroke:#333,stroke-width:2px
        style J fill:#ccf,stroke:#333,stroke-width:2px
    end