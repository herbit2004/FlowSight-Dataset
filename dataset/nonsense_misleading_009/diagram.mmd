graph TD
    A[User Submits Order] --> B{Payment Received?};
    B -- Yes --> C[Acknowledge Order];
    B -- No --> H[Order Delivered];
    C --> D[Fulfill Order];
    D --> E{Inventory Available?};
    E -- Yes --> F[Ship Order];
    E -- No --> G[Order Canceled];
    F --> H;
    H --> I[Send Delivery Confirmation];
    I --> A;
    G --> C;