graph TD
    subgraph 用户请求处理流程
        A[用户请求] --> B{配额检查};
        B -- 配额充足 --> C[请求处理];
        B -- 配额不足 --> D[限流，返回错误];
        C --> E{资源操作};
        E --> F[操作完成];
        F --> G[返回响应];
    end

    subgraph 配额管理服务
        H[配额管理 API] --> I{查询配额};
        I --> J{更新配额};
        J --> K[配额数据存储];
    end

    subgraph 策略配置服务
        L[策略配置 API] --> M{获取策略};
        M --> N[策略数据存储];
    end

    subgraph 监控与告警
        O[监控指标采集] --> P{指标分析};
        P --> Q{告警触发};
        Q --> R[发送告警通知];
    end

    B -- 查询配额 --> I;
    C -- 更新配额 --> J;
    B -- 获取策略 --> M;
    F -- 采集指标 --> O;

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style G fill:#f9f,stroke:#333,stroke-width:2px
    style D fill:#f9f,stroke:#333,stroke-width:2px

    classDef api fill:#ccf,stroke:#333,stroke-width:2px
    classDef storage fill:#cff,stroke:#333,stroke-width:2px
    classDef decision fill:#ffc,stroke:#333,stroke-width:2px
    classDef process fill:#cfc,stroke:#333,stroke-width:2px

    class H,L api;
    class K,N storage;
    class B,I,J,M,P decision;
    class C,E,F,O,Q,R process;

    subgraph 配额恢复机制
        S[定时任务] --> T{检查配额使用量};
        T -- 使用量低于阈值 --> U[恢复配额];
        T -- 使用量高于阈值 --> V[维持配额];
        U --> J;
    end

    subgraph 缓存层
        W[配额缓存] -- 读取/写入 --> I;
        W[配额缓存] -- 读取/写入 --> J;
    end