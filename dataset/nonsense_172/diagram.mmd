graph TD
    A[用户请求] --> B(支付网关);
    B -- 支付成功 --> C{扣款成功?};
    C -- Yes --> D[发送通知消息];
    C -- No --> E[退款];
    E --> B;
    D --> F[更新订单状态];
    F --> A;
    A --> G[用户数据库];
    G --> H{缓存命中?};
    H -- Yes --> A;
    H -- No --> I[数据分析服务];
    I --> J[读缓存];
    J --> A;
    B --> K[鉴权服务];
    K --> L[认证服务];