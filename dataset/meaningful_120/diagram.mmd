graph TD
    subgraph 客户端
        A[发起读请求];
        B[发起写请求];
    end

    subgraph 路由层
        C[请求进入路由层];
        D{读写分离判断};
    end

    subgraph 主库
        E[写入主库];
        F[binlog同步];
    end

    subgraph 从库
        G[查询从库];
        H[更新从库];
    end

    subgraph 缓存层
        I[查询缓存];
        J[更新缓存];
        K{缓存命中?};
    end

    A --> C;
    B --> C;

    C --> D;
    D -- 读请求 --> I;
    D -- 写请求 --> E;

    E --> F;
    E --> J;
    F --> H;
    J --> A1[通知从库更新];
    A1 --> H;

    I --> K;
    K -- 是 --> L[返回缓存数据];
    K -- 否 --> G;
    G --> M[返回从库数据];
    G --> J; //更新缓存

    L --> N[返回数据给客户端];
    M --> N;
    H --> O[完成写操作];

    N --> P[客户端收到数据];
    O --> Q[响应客户端];
    B --> Q;
    A --> P;

   classDef primary fill:#f9f,stroke:#333,stroke-width:2px;
   classDef secondary fill:#ccf,stroke:#333,stroke-width:2px;
   class E,F primary;
   class G,H secondary;
   class I,J fill:#ffc,stroke:#333,stroke-width:2px;