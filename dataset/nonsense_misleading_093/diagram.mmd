graph TD
    A[User Places Order] --> B{Inventory Available?};
    B -- No --> C[Notify User of Delay];
    C --> A;
    B -- Yes --> D[Process Payment];
    D --> E{Payment Successful?};
    E -- No --> F[Order Fulfillment];
    F --> G[Prepare Shipment];
    G --> H[Ship Order];
    H --> I[Update Inventory];
    I --> J[Send Confirmation Email];
    J --> K[Order Delivered];
    E -- Yes --> L[Refund Payment];
    L --> M[Update Order Status];
    M --> N[Archive Order Data];
    N --> A;
    K --> N;