graph TD
    subgraph 用户注册与登录
    A[用户请求: 注册/登录页面] --> B{身份验证方式选择};
    B -- 手机验证码 --> C[发送验证码至手机];
    B -- 邮箱验证 --> D[发送验证邮件];
    B -- 密码登录 --> E[密码验证];
    C --> F[验证码校验];
    D --> G[邮箱Token校验];
    E --> H[数据库查找用户];
    F --> I{验证码正确？};
    G --> J{Token有效？};
    H --> K{用户存在？密码正确？};
    I -- 是 --> L[生成会话令牌];
    I -- 否 --> M[返回错误信息];
    J -- 是 --> L;
    J -- 否 --> M;
    K -- 是 --> L;
    K -- 否 --> M;
    L --> N[写入Redis会话];
    N --> O[返回会话令牌];
    O --> P[用户重定向至主页];
    M --> P;
    end

    classDef error fill:#f9f,stroke:#333,stroke-width:2px
    class M error