graph TD
    A[用户请求] --> B(支付网关);
    B -- 认证失败 --> A;
    B -- 认证成功 --> C{风控系统};
    C -- YES --> D[消息队列];
    C -- NO --> E[记录黑名单];
    E --> A;
    D --> F(订单服务);
    F --> G{写缓存};
    G -- YES --> H[数据库];
    G -- NO --> I[第三方支付];
    I --> H;
    H --> J[发送支付成功消息];
    J --> K(通知服务);
    K --> L[用户];
    L --> M[生成订单];
    M --> F;
    F --> N[更新库存];
    N --> O(积分服务);
    O --> P[用户请求];
    style P fill:#f9f,stroke:#333,stroke-width:2px