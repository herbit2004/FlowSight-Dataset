graph TD
    A[用户请求] --> B(数据库写入);
    B --> C{用户已登录?};
    C -- Yes --> D[API 网关];
    C -- No --> E[重新登录];
    E --> A;
    D --> F(缓存清理);
    F --> G{支付成功?};
    G -- Yes --> H[发送消息到队列];
    G -- No --> I[风控系统];
    I --> J(扣款);
    J --> D;
    H --> K[日志系统];
    K --> L{数据分析};
    L --> B;
    D --> M[返回响应];
    M --> A;