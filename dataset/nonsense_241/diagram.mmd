graph TD
    A[用户请求] --> B(数据库写入);
    B --> C{用户已登录?};
    C -- Yes --> D[访问API];
    C -- No --> E(登录);
    E --> F{登录成功?};
    F -- Yes --> G[更新缓存];
    F -- No --> H(返回错误);
    G --> D;
    D --> I(鉴权);
    I --> J{鉴权通过?};
    J -- Yes --> K[业务逻辑处理];
    J -- No --> L(认证);
    L --> H;
    K --> M(消息队列);
    M --> N[发送支付请求];
    N --> O(支付网关);
    O --> P{支付成功?};
    P -- Yes --> Q[清空缓存];
    P -- No --> R(记录支付失败日志);
    Q --> S(返回结果);
    R --> S;
    S --> A;
    H --> A;
    T[定时任务] --> U(删除缓存);
    U --> V{缓存删除成功?};
    V -- Yes --> T;
    V -- No --> W(发送告警);
    W --> T;
    X[API调用] --> Y(读取缓存);
    Y --> Z{缓存命中?};
    Z -- Yes --> AA[返回缓存数据];
    Z -- No --> BB[查询数据库];
    BB --> CC(写入缓存);
    CC --> AA;
    AA --> X;
    DD[图片上传] --> EE(CDN);
    EE --> FF{上传成功?};
    FF -- Yes --> DD;
    FF -- No --> GG(重试上传);
    GG --> EE;