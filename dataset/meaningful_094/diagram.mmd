graph TD
    subgraph 代码评审与合并流程
        A[提交代码变更];
        B[CI 检查: 单元测试 & 静态分析];
        C{CI 通过?};
        D[指派评审人: 代码模块负责人];
        E[评审人进行代码审查];
        F{需要修改?};
        G[修改代码后重新提交];
        H[评审人批准代码];
        I[自动化集成测试];
        J{集成测试通过?};
        K[自动合并到主干分支];
        L[合并完成: 通知相关人员];

        A --> B;
        B --> C;
        C -- Yes --> D;
        C -- No --> G;
        D --> E;
        E --> F;
        F -- Yes --> G;
        F -- No --> H;
        G --> B;
        H --> I;
        I --> J;
        J -- Yes --> K;
        J -- No --> G;
        K --> L;
    end