graph TD
    subgraph User Authentication Flow
    A[User Input: Email & Password] --> B{Validate Input};
    B -- Invalid Input --> A;
    B -- Valid Input --> C{Check Active User Session};
    C -- Session Found --> D[Redirect to Dashboard];
    C -- No Session Found --> E{Check User Account Status};
    E -- Account Locked --> F[Display Locked Account Message];
    E -- Account Active --> G{Authenticate User};
    E -- Account Pending Verification --> H[Display Verification Required Message];
    G -- Authentication Successful --> I[Create User Session];
    G -- Authentication Failed --> J[Display Login Error Message];
    I --> K[Generate JWT Token];
    K --> L[Set JWT Cookie];
    L --> D;
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    classDef locked fill:#fcc,stroke:#d44,stroke-width:2px
    class F,H locked