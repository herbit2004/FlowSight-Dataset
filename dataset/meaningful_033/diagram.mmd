graph TD
    subgraph 用户触达与资格评估
        A[用户行为触发事件] --> B{是否符合活动规则?};
        B -- 是 --> C[用户资格校验];
        B -- 否 --> Z[活动结束];
        C --> D{是否满足资格条件?};
        D -- 是 --> E[进入活动流程];
        D -- 否 --> Z;
    end

    subgraph 活动流程与奖励发放
        E --> F[个性化活动内容推送];
        F --> G{用户参与活动?};
        G -- 是 --> H[活动进度更新];
        G -- 否 --> I[再次触达提醒];
        I --> F;
        H --> J{活动目标达成?};
        J -- 是 --> K[奖励计算与发放];
        J -- 否 --> L[持续激励];
        L --> F;
        K --> M[奖励到账通知];
        M --> N[数据统计与分析];
    end

    subgraph 风控与异常处理
        N --> O{是否存在异常行为?};
        O -- 是 --> P[风险评估与拦截];
        O -- 否 --> Q[活动效果监控];
        P --> Z;
        Q --> R[活动优化建议];
        R --> F;
    end

    Z[活动结束];

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P,Q,R,Z process