graph TD
    subgraph 订单服务
        A[收到创建订单请求] --> B(参数校验);
        B -- 校验通过 --> C{库存是否充足?};
        C -- 是 --> D[锁定库存];
        C -- 否 --> E[返回库存不足];
    end

    subgraph 库存服务
        F[接收锁定库存请求] --> G(更新库存);
        G --> H[返回锁定结果];
    end

    subgraph 支付服务
        I[接收发起支付请求] --> J(创建支付订单);
        J --> K[返回支付订单信息];
    end

    D -- 锁定成功 --> L[发起支付请求];
    L -- 支付服务 --> I;
    I -- 支付成功 --> M[返回支付成功];
    I -- 支付失败 --> N[返回支付失败];

    M --> O[通知订单服务];
    N --> P[通知订单服务];

    O --> Q[更新订单状态为已支付];
    P --> R[更新订单状态为待支付];
    R --> S[释放已锁定库存];

    E --> T[返回订单创建失败];
    N --> S;

    classDef success fill:#90EE90,stroke:#333,stroke-width:2px;
    class M,O,Q success;