graph TD
    A[用户请求] --> B{缓存命中?}
    B -- Yes --> C[返回缓存数据]
    B -- No --> D[写数据库]
    D --> E[API 网关]
    E --> F{认证?}
    F -- No --> G[返回 401]
    F -- Yes --> H[鉴权]
    H --> I[消息队列]
    I --> J[支付服务]
    J --> K[生成支付订单]
    K --> L[用户]
    L --> M[查询数据库]
    M --> N{查询成功?}
    N -- Yes --> O[发送通知]
    N -- No --> P[重试查询]
    P --> M
    O --> Q[登出]
    Q --> A
    style A fill:#f9f,stroke:#333,stroke-width:2px
    style D fill:#ccf,stroke:#333,stroke-width:2px
    style J fill:#ccf,stroke:#333,stroke-width:2px