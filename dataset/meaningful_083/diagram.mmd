graph TD
    subgraph 产品数据接入
        A[原始数据源] --> B(预处理与清洗);
        B --> C{数据格式校验?};
        C -- 格式正确 --> D(数据存储);
        C -- 格式错误 --> E[数据异常记录];
        D --> F(元数据管理);
    end

    subgraph 抽样策略配置
        G[数据管理员] --> H(配置抽样规则);
        H --> I{抽样规则有效性校验?};
        I -- 有效 --> J(保存抽样规则);
        I -- 无效 --> K[规则调整];
        J --> L(应用抽样规则);
    end

    subgraph 质检流程
        F --> L;
        L --> M(数据抽样);
        M --> N{人工质检?};
        N -- 是 --> O(人工质检);
        N -- 否 --> P(自动化质检);
        O --> Q{质检结果分析?};
        P --> Q;
        Q -- 质量合格 --> R(数据发布);
        Q -- 质量不合格 --> S(问题数据反馈);
        S --> T[数据工程师];
        T --> U(问题数据修复);
        U --> V{修复后重新质检?};
        V -- 是 --> Q;
        V -- 否 --> W[流程结束];
    end

    R --> X(数据应用);
    E --> Y[数据质量监控];
    S --> Y;

    classDef green fill:#90EE90,stroke:#333,stroke-width:2px;
    classDef red fill:#FFB6C1,stroke:#333,stroke-width:2px;
    class D,F,J,R,X green
    class E,K,S red