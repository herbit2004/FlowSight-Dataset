graph TD
    A[用户输入] --> B(意图识别与实体提取);
    B --> C{意图明确？};
    C -- 是 --> D[对话状态管理];
    C -- 否 --> E[模糊意图处理];
    E --> F[多轮意图澄清];
    F --> C;
    D --> G{需要知识库？};
    G -- 是 --> H[知识库检索];
    H --> I(答案生成);
    G -- 否 --> I;
    I --> J[上下文维护];
    J --> K(响应生成);
    K --> L[输出响应];
    L --> M[用户满意度收集];

    classDef customFill fill:#f9f,stroke:#333,stroke-width:2px
    style A,B,C,D,E,F,G,H,I,J,K,L,M customFill