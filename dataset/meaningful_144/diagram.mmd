graph TD
    subgraph 容器编排与扩缩容
        A[用户请求] --> B{入口负载均衡器 Ingress};
        B --> C{服务发现};
        C -- 健康检查 --> D[可用后端 Pod 列表];
        C -- 不健康 --> E[从列表中移除];
        D --> F{路由策略};
        F -- 策略1 --> G[Pod 实例 1];
        F -- 策略2 --> H[Pod 实例 2];
        F -- 策略N --> I[Pod 实例 N];
        G --> J[业务逻辑处理];
        H --> J;
        I --> J;
        J --> K[响应];
        K --> B;

        subgraph 自动扩缩容模块
            L[监控系统 Metrics Server] --> M{HPA 控制器 Horizontal Pod Autoscaler};
            M -- CPU利用率超阈值 --> N[触发 Pod 扩容];
            M -- CPU利用率低于阈值 --> O[触发 Pod 缩容];
            N --> P[部署控制器 Deployment Controller];
            O --> P;
            P --> Q[调整副本数];
            Q --> R[容器运行时 Container Runtime];
            R --> S[创建/销毁 Pod];
            S --> D;
        end

        subgraph 异常处理
            T[Pod 实例异常] --> U[容器探针 Liveness Probe];
            U -- 失败 --> V[重启策略 Restart Policy];
            V --> S;
            V -- 重启失败次数过多 --> W[告警系统];
            W --> X[运维人员介入];
        end

    end

    classDef boxFill fill:#f9f,stroke:#333,stroke-width:2px
    style A,B,C,D,F,G,H,I,J,K,L,M,N,O,P,Q,R,S,T,U,V,W,X boxFill