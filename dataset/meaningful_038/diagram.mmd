graph TD
    subgraph 用户请求分流
        A[用户请求] --> B{用户画像可用?};
        B -- 是 --> C[画像服务];
        B -- 否 --> D[默认分流配置];
        C --> E[计算分流策略];
        E --> F{存在个性化策略?};
        F -- 是 --> G[个性化分组];
        F -- 否 --> D;
        D --> H[基于人群分组];
    end

    subgraph 实验配置校验
        H --> I[校验实验配置];
        I --> J{配置有效?};
        J -- 是 --> K[分配实验组];
        J -- 否 --> L[默认对照组];
    end

    K --> M[返回实验组];
    L --> M;
    M --> N[记录分流日志];

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N process