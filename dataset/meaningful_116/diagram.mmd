graph TD
    subgraph 初始状态
        A[用户发起搜索请求] --> B(查询缓存);
    end

    subgraph 缓存处理
        B -- 缓存命中 --> C{返回缓存结果};
        B -- 缓存未命中 --> D[请求搜索索引服务];
    end

    subgraph 索引服务
        D --> E{解析查询请求};
        E --> F[查询主索引];
        F --> G{检查是否有增量索引};
    end

    subgraph 增量索引处理
        G -- 有增量索引 --> H[查询增量索引];
        H --> I{合并主索引和增量索引结果};
        G -- 无增量索引 --> J[使用主索引结果];
    end

    subgraph 结果处理
        I --> K[排序和过滤结果];
        J --> K;
        K --> L[应用业务规则];
        L --> M[生成最终搜索结果];
        M --> N[更新缓存];
        N --> O[返回搜索结果给用户];
    end

    subgraph 异步索引更新流程
        P[数据变更事件] --> Q[消息队列];
        Q --> R[索引更新服务];
        R --> S{解析变更事件};
        S --> T[更新增量索引];
        T --> U{判断是否需要合并增量到主索引};
        U -- 需要合并 --> V[异步合并增量到主索引];
        U -- 不需要合并 --> W[结束];
        V --> X[清理历史增量];
    end

    C --> O;
    D -. 异步 .- Q;

    classDef sectionFill fill:#f9f,stroke:#333,stroke-width:2px

    class 初始状态,缓存处理,索引服务,增量索引处理,结果处理 sectionFill
    class 异步索引更新流程 sectionFill