graph TD
    A[用户请求] --> B(消息队列);
    B --> C{支付成功?};
    C -- Yes --> D[更新数据库];
    C -- No --> E(网关);
    E --> F[风控系统];
    F --> E;  
    D --> G[缓存失效];
    G --> H(API服务);
    H --> I{用户已登录?};
    I -- Yes --> J[返回数据];
    I -- No --> K[登录];
    K --> A;
    J --> L(负载均衡);
    L --> M[用户响应];

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style M fill:#f9f,stroke:#333,stroke-width:2px

    subgraph 支付流程
        C --> D;
    end

    subgraph 安全流程
        E --> F;
    end

    subgraph 缓存流程
        G --> H;
    end

    subgraph 认证流程
        I --> K;
    end

    subgraph 整体流程
        A --> B;
        B --> C;
        H --> I;
        J --> L;
        L --> M;
    end

    B --> N{数据库写入成功?};
    N -- Yes --> O[发送通知];
    N -- No --> P(重试队列);
    P --> B;

    subgraph 数据库操作
       B --> N;
       N --> O;
       N --> P;
    end

    O --> Q[日志系统];
    Q --> R(监控系统);
    R --> O;

    subgraph 监控告警
        O --> Q;
        Q --> R;
    end