graph TD
    A[用户请求] --> B(数据库写入);
    B --> C{支付成功？};
    C -- Yes --> D[发送消息到队列];
    C -- No --> E(登录);
    E --> F[API 网关];
    F --> G{缓存命中？};
    G -- Yes --> H[更新缓存];
    G -- No --> I[从数据库读取];
    I --> J(读写缓存);
    J --> F;
    D --> K[认证服务];
    K --> L[鉴权服务];
    L --> M(用户请求);
    M --> N[用户响应];