graph TD
    subgraph 特征工程 Pipeline
        A[数据源提取] --> B(数据初步清洗);
        B --> C{缺失值处理策略选择};

        subgraph 缺失值处理
            C -- 均值/中位数填充 --> D[均值/中位数填充模块];
            C -- KNN填充 --> E[KNN填充模块];
            C -- 模型预测填充 --> F[模型预测填充模块];

            D --> G(数据类型转换);
            E --> G;
            F --> G;
        end

        G --> H{异常值检测策略选择};

        subgraph 异常值处理
            H -- IQR方法 --> I[IQR异常值检测模块];
            H -- Z-score方法 --> J[Z-score异常值检测模块];
            H -- Isolation Forest --> K[Isolation Forest异常检测];

            I --> L(异常值处理);
            J --> L;
            K --> L;

            L -- 删除异常值 --> M[异常值删除];
            L -- 替换异常值 --> N[异常值替换];
            L -- 不处理 --> O[保留异常值];

            M --> P(特征编码);
            N --> P;
            O --> P;
        end

        P --> Q{特征编码策略选择};

        subgraph 特征编码
            Q -- One-Hot编码 --> R[One-Hot编码模块];
            Q -- Label Encoding --> S[Label Encoding模块];
            Q -- Target Encoding --> T[Target Encoding模块];
            Q -- WOE Encoding --> U[WOE Encoding模块];

            R --> V(特征缩放);
            S --> V;
            T --> V;
            U --> V;
        end

        V --> W{特征缩放策略选择};

        subgraph 特征缩放
            W -- Min-Max缩放 --> X[Min-Max缩放模块];
            W -- 标准化(StandardScaler) --> Y[StandardScaler模块];
            W -- RobustScaler --> Z[RobustScaler模块];

            X --> AA(特征衍生);
            Y --> AA;
            Z --> AA;
        end

        AA --> BB{特征衍生策略选择};

        subgraph 特征衍生
            BB -- 多项式特征 --> CC[多项式特征衍生模块];
            BB -- 交互特征 --> DD[交互特征衍生模块];
            BB -- 领域知识特征 --> EE[领域知识特征衍生模块];

            CC --> FF(特征选择);
            DD --> FF;
            EE --> FF;
        end

        FF --> GG{特征选择策略选择};

        subgraph 特征选择
            GG -- 方差过滤 --> HH[方差过滤模块];
            GG -- 相关性过滤 --> II[相关性过滤模块];
            GG -- 基于模型的特征选择 --> JJ[基于模型的特征选择];
            GG -- RFE --> KK[RFE特征选择];

            HH --> LL(特征降维);
            II --> LL;
            JJ --> LL;
            KK --> LL;
        end

        LL --> MM{特征降维策略选择};

        subgraph 特征降维
            MM -- PCA降维 --> NN[PCA降维模块];
            MM -- LDA降维 --> OO[LDA降维模块];
            MM -- UMAP降维 --> PP[UMAP降维模块];

            NN --> QQ[特征工程完成];
            OO --> QQ;
            PP --> QQ;
        end

    end

    classDef 数据处理 fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,D,E,F,G,I,J,K,L,M,N,O,P,R,S,T,U,V,X,Y,Z,AA,CC,DD,EE,FF,HH,II,JJ,KK,LL,NN,OO,PP 数据处理
    classDef 决策 fill:#ccf,stroke:#333,stroke-width:2px
    class C,H,Q,W,BB,GG,MM 决策
    classDef 结束 fill:#fcc,stroke:#333,stroke-width:2px
    class QQ 结束