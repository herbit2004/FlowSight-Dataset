graph TD
    A[数据变更事件] --> B{数据异动判断};
    B -- 需要备份 --> C[增量备份任务触发];
    B -- 无需备份 --> D[流程结束];
    C --> E(备份数据准备);
    E --> F{备份目标选择};
    F -- 优先级高 --> G[在线热备库];
    F -- 优先级低 --> H[离线冷备存储];
    G --> I[备份数据写入];
    H --> I;
    I --> J[备份结果验证];
    J --> K[备份任务完成];
    classDef bold fill:#f9f,stroke:#333,stroke-width:2px;
    class A,C,G,H bold;