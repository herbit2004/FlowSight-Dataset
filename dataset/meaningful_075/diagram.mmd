graph TD
    A[用户请求上传图片] --> B{检查访问令牌};
    B -- 有效 --> C[提取用户身份信息];
    B -- 无效 --> E[返回 401 错误];
    C --> D{检查图片是否已水印};
    D -- 是 --> F[返回原图];
    D -- 否 --> G[生成临时水印标识];
    G --> H[调用水印服务];
    H --> I[图片叠加水印];
    I --> J[生成带水印图片];
    J --> K[存储带水印图片];
    K --> L[记录水印日志];
    L --> M[更新水印标识状态];
    M --> N[返回带水印图片URL];
    N --> O[可选: 缓存带水印图片URL];
    style A fill:#f9f,stroke:#333,stroke-width:2px
    style B fill:#ccf,stroke:#333,stroke-width:2px