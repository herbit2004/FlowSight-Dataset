graph TD
    subgraph 用户发起向导
        A[开始] --> B{选择向导类型};
        B -- 新建服务单 --> C[填写服务单信息];
        B -- 创建活动 --> D[配置活动规则];
    end

    subgraph 向导步骤与草稿
        C --> E{校验服务单信息};
        D --> F{校验活动规则};
        E -- 通过 --> G[保存草稿: 服务单];
        E -- 失败 --> C;
        F -- 通过 --> H[保存草稿: 活动];
        F -- 失败 --> D;

        G --> I{提交服务单?};
        H --> J{发布活动?};
        I -- 是 --> K[最终确认服务单];
        J -- 是 --> L[最终确认活动];
        I -- 否 --> M[待提交的服务单草稿];
        J -- 否 --> N[待发布的活动草稿];

        M --> I;
        N --> J;
    end

    subgraph 完成与后续处理
        K --> O[服务单提交成功];
        L --> P[活动发布成功];
        O --> Q[触发后续流程: 服务单];
        P --> R[触发后续流程: 活动];
        Q --> S[结束: 服务单流程];
        R --> S;
    end

    classDef step fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P,Q,R step
    class S fill:#ccf,stroke:#333,stroke-width:2px