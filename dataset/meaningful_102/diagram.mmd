graph TD
    subgraph API网关核心流程
        A[客户端请求] --> B{路由规则匹配器};
        B -- 匹配成功 --> C[目标服务发现];
        B -- 匹配失败 --> E[访问拒绝];
        C --> D{鉴权处理器};
        D -- 鉴权成功 --> F[请求转发];
        D -- 鉴权失败 --> E;
        F --> G[目标服务];
        G --> H[响应返回];
        H --> I[网关日志记录];
        I --> J[客户端响应];
        E --> J;
    end

    subgraph 鉴权处理器内部流程
        D --> D1[身份认证];
        D1 -- 认证成功 --> D2[权限校验];
        D1 -- 认证失败 --> D3[返回 401];
        D2 -- 校验通过 --> D4[请求放行];
        D2 -- 校验失败 --> D3;
        D3 --> E;
        D4 --> F;
    end

    classDef rejected fill:#f9f,stroke:#333,stroke-width:2px
    class E rejected