graph TD
    subgraph "用户请求"
        A[用户请求到达];
    end

    A --> B{请求路由};

    subgraph "缓存层"
        B -- 请求Key 在 路由表吗? --> C{路由表存在Key?};
        C -- 是 --> D[从路由表获取 Cache Group];
        C -- 否 --> E[默认 Cache Group];
        D --> F[构建 Cache Key];
        E --> F;
        F --> G{Cache Group 选择策略};
        G -- 策略1 --> H[选择 Redis 集群 A];
        G -- 策略2 --> I[选择 Redis 集群 B];
        H --> J[读取 Redis A];
        I --> J;

        J -- Key 存在？ --> K{Redis Key 存在?};
        K -- 是 --> L[返回缓存数据];
        K -- 否 --> M[缓存穿透处理];
        M --> N[Bloom Filter 校验];
        N -- Key 存在？ --> O{Bloom Filter 存在?};
        O -- 是 --> P[回源获取数据];
        O -- 否 --> Q[返回空数据];
        P --> R[写入缓存（带过期时间）];
        R --> L;
        Q --> L;
    end

    subgraph "数据源"
        L --> S[返回响应];
        S --> Z[用户收到响应];
        P --> T[查询数据库];
        T --> U[返回数据];
        U --> R;
    end

    subgraph "缓存失效"
        W[监听数据库变更];
        W --> X[删除/更新 Redis Key];
        subgraph "定时任务"
            Y[定期检查过期Key];
            Y -->X;
        end
    end

    classDef important fill:#f9f,stroke:#333,stroke-width:2px
    class A,Z important