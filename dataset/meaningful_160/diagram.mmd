graph TD
    subgraph Rule Engine
      A[Incoming Event] --> B{Rule Set Lookup};
      B -- Rule Set A --> C[Rule Evaluation: A];
      B -- Rule Set B --> D[Rule Evaluation: B];

      C -- Matched Rule --> E[Action Orchestration];
      C -- No Match --> F((Next Rule Set?));
      D -- Matched Rule --> E;
      D -- No Match --> F;

     F -- Yes --> B;
     F -- No --> G[Default Action];

      G --> E;

      E --> H[Action Execution];
      H --> I[Audit Logging];
      H --> J[Result Aggregation];
    end

    subgraph External Systems
      K[External API];
      L[Database];
    end

    H -- Invoke API --> K;
    H -- Update Database --> L;
    J --> M[Response Event];

    style A fill:#f9f,stroke:#333,stroke-width:2px
    classDef cond fill:#ccf,stroke:#333,stroke-width:2px
		classDef step fill:#ddd,stroke:#333,stroke-width:2px

    class B,F cond
    class C,D,E,G,H step
    class I,J step