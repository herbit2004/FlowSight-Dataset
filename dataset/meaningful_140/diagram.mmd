graph TD
    subgraph Tenant A
        A[Tenant A 请求] --> B(API Gateway);
    end

    subgraph Tenant B
        C[Tenant B 请求] --> B;
    end

    B --> D{租户 ID 识别};
    D -- Tenant A --> E[Tenant A 路由规则];
    D -- Tenant B --> F[Tenant B 路由规则];

    E --> G((Tenant A 计算资源));
    F --> H((Tenant B 计算资源));

    G --> I[Tenant A 数据库];
    H --> J[Tenant B 数据库];

    classDef tenantFill fill:#f9f,stroke:#333,stroke-width:2px
    class A,C tenantFill