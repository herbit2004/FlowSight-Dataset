graph TD
    A[User Utterance] --> B{Intent Classification};
    B -- Order Inquiry --> C[Order Status Lookup];
    B -- Return Request --> D[Policy Validation];
    C --> E{Order Found?};
    E -- Yes --> F[Present Order Status];
    E -- No --> G[Clarify Order Details];
    D -- Eligible --> H[Initiate Return Process];
    D -- Ineligible --> I[Explain Policy];
    G --> F;

    classDef intentClass fill:#f9f,stroke:#333,stroke-width:2px
    class B intentClass