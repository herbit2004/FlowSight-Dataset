graph TD
    subgraph 客户提交工单
        A[用户提交工单];
        B[工单系统接收];
    end

    subgraph 初步处理
        C[自动分类工单];
        D{是否需要人工介入?};
    end

    subgraph 自动分配
        E[根据技能组匹配];
        F[根据负载均衡策略分配];
        G[分配给具体客服];
    end

    subgraph 人工介入处理
        H[人工分析工单];
        I[选择合适技能组];
        J[人工分配给客服];
    end

    subgraph 工单处理完成
        K[客服处理工单];
        L[用户确认];
        M[工单关闭];
    end

    A --> B;
    B --> C;
    C --> D;
    D -- 是 --> H;
    D -- 否 --> E;
    E --> F;
    F --> G;
    H --> I;
    I --> J;
    G --> K;
    J --> K;
    K --> L;
    L --> M;

    classDef label fill:#f9f,stroke:#333,stroke-width:2px,font-size:12px,font-family:sans-serif;
    class A,B,C,D,E,F,G,H,I,J,K,L,M label;