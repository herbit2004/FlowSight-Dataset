graph TD
    subgraph 用户行为
    A[用户操作] --> B(埋点SDK);
    end

    B --> C{数据校验};
    C -- 校验失败 --> D[数据丢弃];
    C -- 校验通过 --> E[数据转换];
    E --> F[上报服务];

    subgraph 上报服务
    F --> G{消息队列};
    end

    G --> H[指标计算引擎];
    H --> I{阈值判断};
    I -- 超阈值 --> J[告警服务];
    I -- 正常 --> K[存储];

    subgraph 告警服务
    J --> L(告警通道);
    end

    L --> M{邮件};
    L --> N{短信};
    L --> O{钉钉};

    classDef success fill:#afa,stroke:#333,stroke-width:2px;
    class K success