graph TD
    subgraph 推理服务调用链
        A[用户请求] --> B{鉴权与限流};
        B -- 通过 --> C[请求预处理];
        B -- 拒绝 --> Z[返回错误];
        C --> D{模型路由};
        D -- 模型 A --> E[模型 A 推理服务];
        D -- 模型 B --> F[模型 B 推理服务];
        E --> G[后处理 A];
        F --> H[后处理 B];
        G --> I{结果聚合};
        H --> I;
        I --> J[缓存查询];
        J -- 命中 --> K[返回缓存结果];
        J -- 未命中 --> L[最终结果处理];
        L --> M[缓存更新];
        M --> N[返回结果];
        K --> N;
        N --> O[日志记录];
        O --> P[监控指标上报];
        P --> Q[完成];
        Z --> Q;

        subgraph 模型 A 推理服务内部
            E --> E1[数据准备 A];
            E1 --> E2[模型加载 A];
            E2 --> E3[推理计算 A];
            E3 --> E4[结果格式化 A];
            E4 --> G;
        end

        subgraph 模型 B 推理服务内部
            F --> F1[数据准备 B];
            F1 --> F2[模型加载 B];
            F2 --> F3[特征工程 B];
            F3 --> F4[推理计算 B];
            F4 --> F5[结果校验 B];
            F5 --> H;
        end

        subgraph 后处理 A 内部
            G --> GA1[结果排序 A];
            GA1 --> GA2[结果过滤 A];
            GA2 --> GA3[数据清洗 A];
            GA3 --> I;
        end

        subgraph 后处理 B 内部
            H --> HB1[结果转换 B];
            HB1 --> HB2[置信度校准 B];
            HB2 --> HB3[异常值处理 B];
            HB3 --> I;
        end

        subgraph 缓存更新内部
            M --> MA1[序列化];
            MA1 --> MA2[写入缓存];
        end

        subgraph 最终结果处理内部
            L --> LA1[结果格式化];
            LA1 --> LA2[敏感信息脱敏];
            LA2 --> M;
        end

        subgraph 日志记录内部
            O --> OA1[记录请求信息];
            OA1 --> OA2[记录推理结果];
            OA2 --> P;
        end

    end

    classDef service fill:#f9f,stroke:#333,stroke-width:2px;
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P,Q,Z service;

    classDef internal fill:#ccf,stroke:#333,stroke-width:1px;
    class E1,E2,E3,E4,F1,F2,F3,F4,F5,GA1,GA2,GA3,HB1,HB2,HB3,MA1,MA2,LA1,LA2,OA1,OA2 internal;