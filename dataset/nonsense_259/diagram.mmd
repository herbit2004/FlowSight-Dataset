graph TD
    A[用户请求] --> B{鉴权};
    B -- Yes --> C[写入数据库];
    B -- No --> D[返回错误];
    C --> A;
    A --> E[消息队列];
    E --> F[支付服务];
    F --> G[发送通知];
    G --> H{缓存命中?};
    H -- Yes --> I[返回数据];
    H -- No --> J[读数据库];
    J --> K(API 网关);
    K --> L[写缓存];
    L --> I;
    D --> M[日志记录];
    M --> B;
    F --> N[风控系统];
    N --> F;
    N --> O[结算系统];
    O --> P[登出];
    P --> I;