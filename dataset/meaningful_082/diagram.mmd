graph TD
    subgraph 知识库检索系统
        A[用户查询] --> B(查询预处理);
        B --> C{意图识别};
        C -- 精准查询 --> D[知识库向量检索];
        C -- 模糊查询 --> E[查询改写与扩展];
        E --> F[扩展后向量检索];
        D --> G(结果排序与过滤);
        F --> G;
        G --> H{多轮对话状态判断};
        H -- 需要上下文 --> I[上下文管理];
        H -- 无需上下文 --> J[结果生成与返回];
        I --> B;
        G --> K[知识库更新订阅];
        K --> L(触发索引重建);
        J --> Z[返回用户];
    end

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class B,E,G,I,L process