graph TD
    subgraph 推流端
        A[采集编码] --> B(预处理);
        B --> C{网络状况};
        C -- 良好 --> D[编码压缩];
        C -- 不佳 --> E[码率自适应];
        E --> D;
        D --> F(推流至边缘节点);
    end

    subgraph 拉流端
        G(边缘节点) --> H{鉴权};
        H -- 通过 --> I[分发至CDN];
        H -- 失败 --> J[返回错误];
        I --> K(拉流播放);
    end

    F --> G;

    classDef green fill:#90EE90,stroke:#333,stroke-width:2px;
    class A,D,I green