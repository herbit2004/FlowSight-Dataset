graph TD
    A[Customer Initiates Support Ticket] --> B{Is Severity Urgent?};
    B -- Yes --> C[Escalate to Tier 2 Queue];
    B -- No --> D[Analyze Ticket NLP Sentiment];
    D --> E{Sentiment Score > 0.8?};
    E -- Yes --> F[Route to Proactive Support Team];
    E -- No --> G[Route to Standard Support Queue];
    classDef default fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G default