    K --> A
    J -- No --> H
    H --> L[Business Logic]
    L --> M(Message Queue - Async Task)
    M --> N[Payment Gateway]
    N --> O(Database Read)
    O --> P{Payment Successful?}
    P -- Yes --> Q[Update User Profile]
    P -- No --> R[Rollback Transaction]
    R --> O
    Q --> S[Send Notification]
    S --> A
    H --> T[Audit Logging]
    T --> H
    L --> U[Data Analysis Service]
    U --> V[Reporting Service]
    V --> L