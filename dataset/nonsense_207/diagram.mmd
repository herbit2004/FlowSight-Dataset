graph TD
    A[用户请求] --> B(支付网关);
    B -- Yes --> C{鉴权};
    B -- No --> D[返回错误];
    C --> E[身份认证];
    E --> F(读写分离);
    F -- 读 --> G[写缓存];
    F -- 写 --> H(消息队列);
    H --> I[用户服务];
    I --> J{数据库};
    J -- Yes --> K[用户服务];
    J -- No --> L[返回失败];
    H --> M[风控系统];
    M --> N{黑名单?};
    N -- Yes --> O[记录异常];
    N -- No --> P[发送通知];
    P --> Q[更新缓存];
    Q --> R(API 网关);
    R --> S[返回成功];
    G --> T[日志服务];
    T --> A;  
    O --> U[数据分析];
    U --> A;
    style J fill:#f9f,stroke:#333,stroke-width:2px