graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户已登录?};
    C -- Yes --> D[生成 JWT];
    C -- No --> E[返回 401];
    D --> F(API 网关);
    F --> G{权限校验?};
    G -- Yes --> H[请求缓存];
    G -- No --> I[返回 403];
    H --> J{缓存命中?};
    J -- Yes --> K[返回缓存数据];
    J -- No --> L[调用下游服务];
    L --> M(消息队列);
    M --> N[下游服务处理];
    N --> O(支付系统);
    O --> P[完成支付];
    P --> L;
    K --> A;
    I --> A;
    E --> A;