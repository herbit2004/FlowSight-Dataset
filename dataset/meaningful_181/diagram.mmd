graph TD
    subgraph 揽件流程
        A[揽件员APP发起揽件];
        B[PDA扫描包裹];
        C[上传揽件数据];
    end

    subgraph 中转流程
        D[分拣中心接收包裹];
        E[扫描入库];
        F{是否需跨区转运?};
        G[包裹装车];
        H[运输至下一分拣中心];
    end

    subgraph 末端派送
        I[派送员APP获取派送任务];
        J[扫描包裹，更新派送状态];
        K[联系收件人];
        L{是否成功签收?};
        M[更新签收信息];
        N[上传POD照片];
    end

    A --> B --> C --> D;
    D --> E --> F;
    F -- 是 --> G --> H --> D;
    F -- 否 --> I;
    I --> J --> K;
    K --> L;
    L -- 是 --> M --> N;
    L -- 否 --> I;

    classDef important fill:#f9f,stroke:#333,stroke-width:2px;
    class A,N important