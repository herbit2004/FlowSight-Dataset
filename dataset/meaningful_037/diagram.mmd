graph TD
    subgraph 前端埋点流程
    A[用户行为触发] --> B{事件类型判断};
    B -- 自定义事件 --> C[数据预处理];
    B -- 页面浏览事件 --> D[提取页面信息];
    C --> E[添加设备信息];
    D --> E;
    E --> F[数据格式化];
    F --> G{是否需要立即发送};
    G -- 是 --> H[立即发送埋点数据];
    G -- 否 --> I[加入本地缓存];
    I --> J{缓存是否达到阈值};
    J -- 是 --> H;
    J -- 否 --> K[定时器检查];
    K --> L{定时器触发};
    L -- 是 --> H;
    L -- 否 --> K;
    H --> M[发送埋点数据服务];
    end

    subgraph 后端埋点处理流程
    M --> N[接收埋点数据];
    N --> O[数据校验及清洗];
    O --> P{数据质量是否合格};
    P -- 是 --> Q[数据转换];
    P -- 否 --> R[记录异常数据];
    Q --> S[存储到数据仓库];
    S --> T{是否需要实时分析};
    T -- 是 --> U[实时流计算];
    T -- 否 --> V[离线批处理];
    U --> W[实时报表生成];
    V --> X[生成离线报表];
    W --> Y[报表展示与分析];
    X --> Y;
    Y --> Z{是否需要告警};
    Z -- 是 --> AA[触发告警];
    Z -- 否 --> AB[流程结束];
    end

    subgraph 数据分析与应用
    S --> AC[数据挖掘与探索];
    AC --> AD[用户画像构建];
    AD --> AE[个性化推荐];
    AD --> AF[精细化运营];
    AE --> AG[效果评估];
    AF --> AG;
    AG --> AH[优化埋点策略];
    AH --> A;

    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style M fill:#ccf,stroke:#333,stroke-width:2px
    style S fill:#ddf,stroke:#333,stroke-width:2px
    style Y fill:#eef,stroke:#333,stroke-width:2px
    style AH fill:#eff,stroke:#333,stroke-width:2px

    classDef conditional fill:#fff7e6,stroke:#333,stroke-width:1px;
    classDef process fill:#e6f9e6,stroke:#333,stroke-width:1px;
    class B,G,J,L,P,T,Z conditional;
    class C,D,E,F,H,I,K,N,O,Q,U,V,W,X,AC,AD,AE,AF,AG process;