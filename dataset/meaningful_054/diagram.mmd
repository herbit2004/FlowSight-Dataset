graph TD
    A[工单创建];
    B{SLA 匹配};
    C[SLA 规则引擎];
    D{SLA 已命中};
    E[启动 SLA 时钟];
    F[SLA 倒计时];
    G{SLA 超时};
    H[一级升级];
    I[二级升级];
    J[通知值班经理];
    K[自动分配];
    L[工单解决];
    M[SLA 时钟停止];
    N[记录 SLA 信息];
    O[关闭工单];
    P[重新评估优先级];
    Q[更新工单信息];
    R[等待解决];
    S[技术支持团队];
    T[业务支持团队];

    A --> B;
    B -- 是 --> D;
    B -- 否 --> P;
    P --> Q;
    Q --> B;

    D --> E;
    E --> F;
    F --> R;

    R -- 超时 --> G;
    R -- 解决 --> L;

    G -- 一级超时 --> H;
    H --> S;
    S --> R;
    G -- 二级超时 --> I;
    I --> T;
    T --> R;
    G -- 更高级别超时 --> J;
    J --> K;
    K --> R;

    L --> M;
    M --> N;
    N --> O;

    classDef important fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,D,E,G important