graph TD
    A[用户请求] --> B(数据库);
    B --> C{数据校验};
    C -- Yes --> D[写缓存];
    C -- No --> E[返回错误];
    D --> A;
    A --> F[认证];
    F --> G{权限校验};
    G -- No --> E;
    G -- Yes --> H[API 网关];
    H --> I[支付服务];
    I --> J{支付成功};
    J -- Yes --> K[发送消息至队列];
    J -- No --> L[订单取消];
    K --> M[同步数据至数据库];
    M --> L;
    L --> A;