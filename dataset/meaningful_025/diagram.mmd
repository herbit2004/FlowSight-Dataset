graph TD
    subgraph 数据分片路由
        A[请求接入层] --> B{路由决策器};
        B -- 一致性哈希(商户ID) --> C{配置中心};
        C --> D[分片规则配置];
        B -- 动态权重调整 --> E[流量观测器];
        E --> F[权重调整策略];
        B --> G{目标分片定位};
        G --> H[数据节点管理器];
        H --> I[实际数据节点];

        subgraph 异常处理
            I -- 数据节点故障 --> J[故障转移模块];
            J --> K[备用数据节点];
            K --> I;
        end
    end

    classDef normal fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,H,I,J,K normal