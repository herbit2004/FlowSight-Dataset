graph TD
    A[用户请求] --> B(消息队列);
    B --> C{订单服务};
    C -- Yes --> D[支付网关];
    C -- No --> E[风控系统];
    E --> F{黑名单校验};
    F -- Yes --> G[拒绝请求];
    F -- No --> H[用户数据库];
    H --> I((数据校验));
    I --> J{校验通过？};
    J -- Yes --> K[写入缓存];
    J -- No --> G;
    D --> L[支付渠道];
    L --> M((支付结果));
    M --> N[账务系统];
    N --> O[订单数据库];
    O --> A;
    K --> P[返回响应];
    P --> A;
    style A fill:#f9f,stroke:#333,stroke-width:2px
    style G fill:#f9f,stroke:#333,stroke-width:2px