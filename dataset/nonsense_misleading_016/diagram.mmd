graph TD
    A[Receive Customer Order] --> B{Inventory Check};
    B -- Yes --> C[Payment Processing];
    B -- No --> F[Cancel Order];
    C --> D{Payment Successful?};
    D -- No --> C;
    D -- Yes --> E[Shipping Notification];
    E --> A;
    F --> G[Notify Customer of Cancellation];
    G --> H[Log Cancellation Reason];
    H --> I[Update Inventory];
    I --> J[Send Order to Warehouse];
    J --> K[Pack Order];
    K --> L[Ship Order];
    L --> M[Order Delivered];
    M --> N[Send Post-Delivery Survey];
    N --> O[Complete Order];