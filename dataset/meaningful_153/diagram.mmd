graph TD
    subgraph 配置变更与回滚流程
        A[用户发起配置变更请求];
        B[权限校验];
        C{权限校验通过？};
        D[提交配置变更内容];
        E[配置变更内容校验];
        F{配置变更内容校验通过？};
        G[生成配置变更版本];
        H[发布配置变更];
        I[监控配置变更影响];
        J{影响正常？};
        K[配置变更完成];
        L[记录配置变更日志];
        M[触发回滚流程];
        N[选择回滚版本];
        O[回滚版本校验];
        P{回滚版本校验通过？};
        Q[执行回滚];
        R[回滚完成];
        S[通知相关人员];
        T[回滚失败];
        U[记录回滚日志];
        V[通知相关人员];
        W[配置变更失败];
        X[通知相关人员];
        Y[生成告警];
        Z[人工介入];
        AA[等待人工处理];
        BB[人工处理完成];
        CC[继续发布流程];
        DD[配置变更已存在];
        EE[数据不一致问题];
        FF[数据一致性校验];

        A --> B;
        B --> C;
        C -- 是 --> D;
        C -- 否 --> X;
        D --> E;
        E --> F;
        F -- 是 --> G;
        F -- 否 --> W;
        G --> H;
        H --> I;
        I --> J;
        J -- 是 --> K;
        J -- 否 --> M;
        K --> L;
        L --> S;
        M --> N;
        N --> O;
        O --> P;
        P -- 是 --> Q;
        P -- 否 --> T;
        Q --> R;
        R --> S;
        T --> U;
        U --> V;
        W --> X;
        M --> Y;
        Y --> Z;
        Z --> AA;
        AA --> BB;
        BB --> EE;
        EE --> FF;
        FF --> P;
        D --> DD;
        DD --> W;

        classDef ok fill:#afa,stroke:#333,stroke-width:2px;
        classDef error fill:#fbb,stroke:#333,stroke-width:2px;
        class K,R,S ok
        class W,T,X error
    end