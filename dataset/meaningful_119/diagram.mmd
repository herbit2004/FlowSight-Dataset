graph TD
    subgraph 灰度发布流程
        A[用户请求到达];
        B{流量治理组件};
        C{灰度策略匹配};
        D[符合灰度条件];
        E[新版本集群];
        F[旧版本集群];
        G[新版本服务处理请求];
        H[旧版本服务处理请求];
        I[响应返回给用户];
        J[监控系统];
        K[数据分析平台];
        L[灰度发布平台];
        M[上线验证];
        N[全量发布];
    end

    A --> B;
    B --> C;
    C -- 符合条件 --> D;
    C -- 不符合条件 --> F;
    D --> E;
    E --> G;
    F --> H;
    G --> I;
    H --> I;

    subgraph 灰度策略配置
        O[灰度策略配置];
        P[配置中心];
        Q[实时更新];
        L --> O;
        O --> P;
        P --> Q;
        Q --> C;
    end

    subgraph 监控与分析
        I --> J;
        J --> K;
        K --> L;
        K --> M;
        M -- 验证通过 --> N;
        M -- 验证失败 --> L;
        N --> End((全量上线));
    end

    classDef condition fill:#f9f,stroke:#333,stroke-width:2px
    class D,C condition

    classDef version fill:#ccf,stroke:#333,stroke-width:2px
    class E,F version

    classDef analysis fill:#afa,stroke:#333,stroke-width:2px
    class J,K analysis