graph TD
    subgraph 数据采集层
        A[实时数据源: Kafka / Pulsar] --> B(数据清洗与转换);
        B --> C{数据质量检测};
        C -- 异常数据 --> D[异常数据告警];
        C -- 合格数据 --> E(数据聚合计算);
    end

    subgraph 数据处理层
        E --> F{数据存储选型};
        F -- 时序数据 --> G[时序数据库: InfluxDB / TimescaleDB];
        F -- 聚合数据 --> H[KV数据库: Redis];
    end

    subgraph 实时计算层
        I(Flink / Spark Streaming) --> J{业务规则处理};
        J -- 规则一 --> K[指标A计算];
        J -- 规则二 --> L[指标B计算];
        K --> M(指标合并);
        L --> M;
        M --> N(数据推送);
    end

    subgraph 大屏展示层
        N --> O[WebSocket服务器];
        O --> P[前端大屏应用];
    end

    subgraph 监控告警层
        G --> Q[时序数据监控];
        H --> R[KV数据监控];
        Q --> S{阈值告警};
        R --> S;
        S -- 超出阈值 --> T[告警通知];
        T --> U[短信/邮件/钉钉];
    end

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class B,E,I,J,M process