graph TD
    A[Start: Order Placed] --> B{Inventory Check};
    B -- Available --> C[Process Payment];
    B -- Unavailable --> H[Notify Customer: Out of Stock];
    C -- Success --> D[Generate Shipping Label];
    C -- Failure --> I[Refund Payment];
    D --> E[Pack Order];
    E --> F[Order Shipped];
    F --> G[Deliver Order];
    G --> B;
    I --> A;
    H --> F