graph TD
    A[User Places Order] --> B{Payment Received?};
    B -- No --> C[Send Order Confirmation];
    B -- Yes --> D[Inventory Check];
    D -- Insufficient --> E[Notify User of Delay];
    E --> A; 
    D -- Sufficient --> F[Packaging];
    F --> G{Shipping Address Valid?};
    G -- No --> H[Process Shipment];
    G -- Yes --> I[Generate Shipping Label];
    I --> J[Shipping];
    J --> K[Order Delivered];
    K --> L[Close Order];
    H --> M[Payment Refunded];
    M --> L;