graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户已登录?};
    C -- Yes --> D[API 网关];
    C -- No --> E[登录];
    E --> F(数据库);
    F --> G{登录成功?};
    G -- Yes --> D;
    G -- No --> H[返回错误];
    D --> I[鉴权];
    I --> J[认证];
    J --> K{权限足够?};
    K -- Yes --> L[读缓存];
    L --> M[业务处理];
    K -- No --> N[返回错误];
    M --> O[消息队列];
    O --> P(数据库);
    P --> Q[写缓存];
    Q --> R[生成响应];
    R --> A;
    D --> S[计费服务];
    S --> T[支付网关];
    T --> U(数据库);
    U --> V[返回支付结果];
    V --> R;