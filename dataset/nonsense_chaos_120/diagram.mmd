graph TD
    A[Start: ChronosInitiation Protocol] --> B{Aetherium Check};
    B -- Aetherium Active --> C[FluxDrive Calibration];
    B -- Aetherium Inactive --> D[SpectraCore Boot Sequence];
    C --> E{CoreSync Validation};
    D --> E;
    E -- Validation Passed --> F[VaultNode Handshake];
    E -- Validation Failed --> G[Re-Initialize SpectraCore];
    F --> H{ZenithGate Auth Layer};
    G --> D;
    H -- Auth Success --> I[ArcLane Distributor Setup];
    H -- Auth Failure --> J[Log Failure Event];
    I --> K[Start Zenith Beacon];
    J --> L[Terminate ChronosInitiation];
    K --> L;

    L[End: ChronosInitiation Terminated];

    subgraph System Initialization
        A
        B
        C
        D
        E
        F
        G
        H
        I
        J
        K
        L
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style L fill:#f9f,stroke:#333,stroke-width:2px