graph TD
    subgraph 系统配置变更与回滚流程
        A[配置变更请求] --> B{权限校验};
        B -- 通过 --> C[生成变更工单];
        B -- 失败 --> Reject[拒绝请求];
        C --> D[人工审核];
        D -- 批准 --> E[生成配置快照];
        D -- 拒绝 --> Reject;
        E --> F[锁定配置];
        F --> G[应用配置变更];
        G --> H{变更验证};
        H -- 成功 --> I[更新配置快照];
        H -- 失败 --> J[启动回滚];
        I --> K[解锁配置];
        K --> L[变更完成];
        J --> M[恢复配置快照];
        M --> N{回滚验证};
        N -- 成功 --> O[解锁配置];
        N -- 失败 --> P[告警并停止回滚];
        O --> Q[回滚完成];
        Q --> End[流程结束];
        P --> End;
        L --> End;
        Reject --> End;

        subgraph 回滚分支
            style J fill:#f9f,stroke:#333,stroke-width:2px
            style M fill:#f9f,stroke:#333,stroke-width:2px
            style N fill:#f9f,stroke:#333,stroke-width:2px
            style O fill:#f9f,stroke:#333,stroke-width:2px
            style Q fill:#f9f,stroke:#333,stroke-width:2px
            style P fill:#f9f,stroke:#333,stroke-width:2px
        end

        subgraph 正常变更分支
            style A fill:#ccf,stroke:#333,stroke-width:2px
            style B fill:#ccf,stroke:#333,stroke-width:2px
            style C fill:#ccf,stroke:#333,stroke-width:2px
            style D fill:#ccf,stroke:#333,stroke-width:2px
            style E fill:#ccf,stroke:#333,stroke-width:2px
            style F fill:#ccf,stroke:#333,stroke-width:2px
            style G fill:#ccf,stroke:#333,stroke-width:2px
            style H fill:#ccf,stroke:#333,stroke-width:2px
            style I fill:#ccf,stroke:#333,stroke-width:2px
            style K fill:#ccf,stroke:#333,stroke-width:2px
            style L fill:#ccf,stroke:#333,stroke-width:2px
        end

    end
    classDef rollback fill:#f9f,stroke:#333,stroke-width:2px;
    class J,M,N,O,Q,P rollback;
    classDef normal fill:#ccf,stroke:#333,stroke-width:2px;
    class A,B,C,D,E,F,G,H,I,K,L normal;
    classDef reject fill:#fcc,stroke:#333,stroke-width:2px;
    class Reject reject;
    classDef endfill fill:#eee,stroke:#333,stroke-width:2px;
    class End endfill;