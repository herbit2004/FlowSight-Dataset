graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户认证?};
    C -- Yes --> D[生成JWT];
    C -- No --> E[返回错误];
    D --> F[权限校验];
    F --> G{权限足够?};
    G -- No --> E;
    G -- Yes --> H[读缓存];
    H --> I{缓存命中?};
    I -- Yes --> J[支付服务];
    I -- No --> K[更新缓存];
    K --> L[API 网关];
    L --> A;
    J --> M[消息队列];
    M --> N[订单服务];
    N --> O[写日志];
    O --> P{支付成功?};
    P -- Yes --> Q[发送通知];
    P -- No --> R[回滚订单];
    R --> M;
    Q --> L;