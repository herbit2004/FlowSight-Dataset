graph TD
    A[接收转码/截图请求] --> B{检查队列长度};
    B -- 队列未满 --> C[压入延时队列];
    B -- 队列已满 --> D[拒绝请求并返回错误];
    C --> E[延时队列调度器];
    E --> F{检查存储资源};
    F -- 资源充足 --> G[选取转码/截图节点];
    F -- 资源不足 --> H[告警并重试];
    G --> I[执行转码/截图任务];
    I --> J{任务成功/失败};
    J -- 成功 --> K[上传结果至存储];
    J -- 失败 --> L[记录失败日志并重试];
    K --> M[发送完成回调];