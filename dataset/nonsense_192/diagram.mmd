graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户已登录？};
    C -- Yes --> D[生成 Token];
    C -- No --> E[登录];
    E --> F(鉴权);
    F --> G[重试请求];
    G --> A;
    D --> H(缓存过期时间);
    H --> I{支付成功？};
    I -- Yes --> J[调用支付API];
    I -- No --> K[返回用户数据];
    J --> L(消息队列);
    L --> M[风控系统];
    M --> N{风控通过？};
    N -- Yes --> O[更新数据库];
    N -- No --> P[拒绝支付];
    P --> K;
    O --> Q(网关);
    Q --> R[读缓存];
    R --> S{缓存命中？};
    S -- Yes --> T[更新缓存];
    S -- No --> U[从数据库读取];
    U --> T;
    T --> V[发送通知];
    V --> K;
    K --> A;