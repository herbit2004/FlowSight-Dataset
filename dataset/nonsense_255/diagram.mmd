graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户已登录?};
    C -- Yes --> D[API 网关];
    C -- No --> E[登录];
    E --> A;
    D --> F(认证);
    F --> G(鉴权);
    G --> H{权限足够?};
    H -- Yes --> I[写缓存];
    H -- No --> J[返回 403];
    I --> K(消息队列);
    K --> L[支付服务];
    L --> M{支付成功?};
    M -- Yes --> N[业务逻辑处理];
    M -- No --> J;
    N --> O[更新数据库];
    O --> P(读缓存);
    P --> A;
    J --> A;