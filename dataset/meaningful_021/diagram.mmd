graph TD
    subgraph 定时任务调度系统
    A[任务触发器] --> B{任务类型判断};
    B -- HTTP任务 --> C[HTTP任务执行器];
    B -- Shell任务 --> D[Shell任务执行器];
    B -- Spark任务 --> E[Spark任务提交器];
    C --> F{HTTP状态码检测};
    D --> G{Shell执行结果检测};
    E --> H{Spark任务状态监控};
    F -- 成功 --> I[结果记录];
    F -- 失败 --> J[失败告警];
    G -- 成功 --> I;
    G -- 失败 --> J;
    H -- 完成 --> I;
    H -- 失败 --> J;
    I --> K[日志记录];
    end

    style J fill:#f9f,stroke:#333,stroke-width:2px