graph TD
    subgraph Real-Time Dashboard Data Pipeline
        A[Sensor Data Source] --> B(Raw Data Ingestion);
        B --> C{Data Quality Check};
        C -- Valid Data --> D[Real-Time Transformation];
        C -- Invalid Data --> E[Alerting System];
        D --> F(Feature Extraction);
        F --> G{Aggregation Logic};
        G -- Per-Widget Aggregation --> H[Widget Data Store];
        G -- System-Wide Aggregation --> I[System Performance Store];
        H --> J(Dashboard API Endpoint);
        I --> K(Monitoring API Endpoint);
        J --> L[Real-Time Dashboard];
        K --> M[Admin Monitoring UI];
        E --> N[Operations Team];
    end