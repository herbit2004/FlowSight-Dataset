graph TD
    subgraph 组件依赖与许可分析流程
        A[开始：提交构建工件];
        B[解析依赖关系];
        C{依赖项类型判断};
        D[直接依赖];
        E[传递依赖];
        F[汇总依赖清单];
        G[查询许可信息];
        H{许可类型判断};
        I[已知许可];
        J[未知许可];
        K[生成许可报告草稿];
        L[人工审核与确认];
        M{审核结果};
        N[通过审核];
        O[需进一步调查];
        P[更新许可信息];
        Q[生成最终许可报告];
        R[发布构建工件];
        S[结束];
    end

    A --> B;
    B --> C;
    C -- 直接 --> D;
    C -- 传递 --> E;
    D --> F;
    E --> F;
    F --> G;
    G --> H;
    H -- 已知 --> I;
    H -- 未知 --> J;
    I --> K;
    J --> K;
    K --> L;
    L --> M;
    M -- 通过 --> N;
    M -- 需调查 --> O;
    O --> P;
    P --> K;
    N --> Q;
    Q --> R;
    R --> S;

    classDef critical fill:#f9f,stroke:#333,stroke-width:2px
    class J,O critical

    subgraph 辅助流程
        AA[扫描代码库];
        BB[发现新依赖];
        CC[更新依赖清单];
        DD[定期触发];
        AA --> BB;
        BB --> CC;
        CC --> F;
        DD --> AA;
    end

    style AA fill:#ccf,stroke:#333,stroke-width:1px
    style BB fill:#ccf,stroke:#333,stroke-width:1px
    style CC fill:#ccf,stroke:#333,stroke-width:1px
    style DD fill:#ccf,stroke:#333,stroke-width:1px