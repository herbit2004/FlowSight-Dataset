graph TD
    A[用户请求] --> B(数据库);
    B --> C{数据已存在?};
    C -- Yes --> D[读缓存];
    C -- No --> E[写缓存];
    E --> F[API Gateway];
    F --> G{支付成功?};
    G -- Yes --> H[生成订单];
    G -- No --> I[通知用户失败];
    H --> J[消息队列];
    J --> K[库存服务];
    K --> L{库存充足?};
    L -- Yes --> M[扣减库存];
    L -- No --> N[补偿用户];
    M --> O[发货服务];
    O --> P[用户收到商品];
    P --> Q[用户评价];
    Q --> R[数据分析];
    R --> S[优化策略];
    S --> A;
    D --> T[用户响应];
    I --> U[记录日志];
    N --> V[风控系统];
    V --> L;
    U --> B;
    T --> A;
    F --> W[认证];
    W --> X[鉴权];
    X --> F;
    subgraph 支付流程
    G
    I
    end
    subgraph 库存流程
    K
    L
    M
    N
    end