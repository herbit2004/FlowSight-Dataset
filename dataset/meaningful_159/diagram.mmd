graph TD
    A[开始: 归档清理流程触发] --> B{数据类型判断};
    B -- 类型A:日志数据 --> C[日志归档模块];
    B -- 类型B:用户行为数据 --> D[用户行为数据清理模块];
    B -- 类型C:交易数据 --> E[交易数据归档模块];

    C --> C1{日志数据量阈值判断};
    C1 -- 超出阈值 --> C2[压缩日志数据];
    C1 -- 未超出阈值 --> C3[转移到近线存储];
    C2 --> C3;
    C3 --> C4[备份至归档存储];
    C4 --> C5[更新日志索引];
    C5 --> F[归档完成];

    D --> D1{用户活跃度评估};
    D1 -- 不活跃用户 --> D2[标记为可清理];
    D1 -- 活跃用户 --> D3[保留用户行为数据];
    D2 --> D4[数据脱敏];
    D4 --> D5[从在线库删除];
    D5 --> D6[记录清理日志];
    D6 --> F;
    D3 --> F;

    E --> E1{数据生命周期判断};
    E1 -- 超过生命周期 --> E2[数据校验];
    E1 -- 未超过生命周期 --> F;
    E2 --> E3[数据转换];
    E3 --> E4[数据加密];
    E4 --> E5[上传至冷存储];
    E5 --> E6[更新交易索引];
    E6 --> F;

    F[结束: 归档清理完成];

    classDef important fill:#f9f,stroke:#333,stroke-width:2px;
    class C1,D1,E1 important;