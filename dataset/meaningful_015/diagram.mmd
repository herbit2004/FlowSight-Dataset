graph TD
    subgraph 应用层
        A[用户发起请求] --> B{权限校验器};
    end
    
    subgraph 权限校验器
        B --> C{获取用户角色};
        C --> D{获取资源所需权限};
        D --> E{匹配用户角色权限与资源权限};
        E -- 权限足够 --> F[允许访问];
        E -- 权限不足 --> G[拒绝访问];
    end

    subgraph 资源层
        F --> H[访问资源];
        G --> I[返回无权访问];
    end

    subgraph 权限管理服务
        C --> J[调用权限管理服务];
        D --> J;
        J --> K[查询角色权限];
        K --> C;
        K --> D;
    end

    subgraph 审计日志
        F --> L[记录访问日志];
        G --> L;
    end

    subgraph 安全策略引擎
        E --> M{调用安全策略引擎};
        M -- 策略允许 --> F;
        M -- 策略拒绝 --> G;
        J --> N[调用安全策略引擎];
        N --> K;
    end

    subgraph 风险评估
        L --> O[数据分析];
        O --> P{风险评估};
        P -- 风险较高 --> Q[触发告警];
        P -- 风险较低 --> R[正常流程];
    end

    classDef process fill:#f9f,stroke:#333,stroke-width:2px
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P,Q,R process