graph TD
    A[用户请求] --> B(数据库);
    B --> C{数据存在?};
    C -- Yes --> D[返回数据];
    C -- No --> E[读缓存];
    E --> F{缓存命中?};
    F -- Yes --> B;
    F -- No --> G[调用API];
    G --> H[写入缓存];
    H --> I[数据处理];
    I --> D
    D --> A;
    A --> J[支付网关];
    J --> K{支付成功?};
    K -- Yes --> L[发送消息到队列];
    K -- No --> M[订单失败];
    L --> N[结算服务];
    N --> O[生成报表];
    O --> M
    M --> A