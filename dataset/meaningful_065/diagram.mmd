graph TD
    subgraph 设备端
        A[启动] --> B{检查升级请求};
        B -- 有升级请求 --> C[解析升级包元数据];
        B -- 无升级请求 --> A;
        C --> D{验证升级包签名};
        D -- 签名有效 --> E[更新 Bootloader];
        D -- 签名无效 --> F[上报错误，重启];
        E --> G[重启进入 Bootloader];
        G --> H[备份当前固件];
        H --> I[擦除程序分区];
        I --> J[写入新固件];
        J --> K{写入校验};
        K -- 校验通过 --> L[更新成功，重启];
        K -- 校验失败 --> M[恢复备份固件];
        M --> L
        L --> N[启动新固件];
        N --> O[自检];
        O -- 自检通过 --> P[完成];
        O -- 自检失败 --> Q[回滚固件];
        Q --> N;
        F --> A
    end

    subgraph 服务端
        R[用户发起升级请求] --> S[生成升级包];
        S --> T[签名升级包];
        T --> U[上传升级包至服务器];
        U --> V[发送升级通知];
        V --> W[等待设备端反馈];
        W --> X{收到设备端反馈};
        X -- 成功 --> Y[记录升级成功];
        X -- 失败 --> Z[记录升级失败];
        Y --> AA[完成];
        Z --> AA
    end
    V -- 超时 --> Z

    classDef success fill:#90EE90,stroke:#333,stroke-width:2px;
    classDef failure fill:#FFB347,stroke:#333,stroke-width:2px;
    class L,N,P success;
    class F,M,Q,Z failure;