graph TD
    A[用户请求] --> B(消息队列);
    B --> C{已登录？};
    C -- Yes --> D[鉴权];
    C -- No --> E[认证];
    E --> F[API 网关];
    F --> E;  
    D --> G[用户服务];
    G --> H{权限足够？};
    H -- Yes --> I[读取缓存];
    H -- No --> J[返回 403];
    I --> K[数据库];
    K --> I;
    I --> L[支付服务];
    L --> M{支付成功？};
    M -- Yes --> N[写入数据库];
    M -- No --> J;
    N --> O[日志服务];
    O --> P[生成报告];
    P --> Q[返回结果];
    Q --> A;
    J --> Q;
    subgraph "核心流程"
    I
    K
    N
    end
    style I fill:#f9f,stroke:#333,stroke-width:2px
    style K fill:#ccf,stroke:#333,stroke-width:2px
    style N fill:#ccf,stroke:#333,stroke-width:2px