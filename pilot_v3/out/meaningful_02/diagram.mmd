graph TD
    A[用户查询输入];
    B{查询解析器};
    C[分词器];
    D[倒排索引查询];
    E[文档评分排名];
    F[结果集];
    G[高亮器];
    H[摘要生成器];
    I[最终结果呈现];

    A --> B;
    B -- 语义分析 --> C;
    B -- 语法分析 --> D;
    C --> D;
    D --> E;
    E --> F;
    F --> G;
    F --> H;
    G --> I;
    H --> I;

    classDef process fill:#f9f,stroke:#333,stroke-width:2px;
    class B,C,D,E,G,H process;