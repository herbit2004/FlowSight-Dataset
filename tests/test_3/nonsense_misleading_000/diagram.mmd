graph TD
    A[Start] --> B{Check Status};
    B -- Yes --> C[Process];
    B -- No --> D[Notify];
    C --> E[Store];
    E -- Success --> F[Route];
    E -- Failure --> D;
    F --> G{Validate};
    G -- Yes --> H[Retry];
    G -- No --> I[Completion];
    H --> C;
    D --> J[End];
    I --> A;  style I fill:#f9f,stroke:#333,stroke-width:2px