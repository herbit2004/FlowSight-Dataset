graph TD
    A[Start] --> B(Process Data);
    B -- Success --> C{Check Limits};
    C -- Yes --> D[Notify User];
    C -- No --> E[Store Data];
    E --> B;
    B -- Failure --> F[End];
    D --> G{Validate Output};
    G -- No --> A;
    G -- Yes --> H[Apply Filters];
    H --> I{Route Data};
    I -- Priority --> E;
    I -- Normal --> F;