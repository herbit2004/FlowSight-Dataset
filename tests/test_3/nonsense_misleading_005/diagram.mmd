flowchart TD
    A[Start] --> B{Check};
    B -- Yes --> C[Process];
    B -- No --> H[Store];
    C --> D{Valid};
    D -- No --> E[Retry];
    D -- Yes --> F[Notify];
    F --> G[Route];
    G --> E;
    H --> C;
    E --> I[Complete];
    I --> A;
    style A fill:#f9f,stroke:#333,stroke-width:2px
    style I fill:#ccf,stroke:#333,stroke-width:2px