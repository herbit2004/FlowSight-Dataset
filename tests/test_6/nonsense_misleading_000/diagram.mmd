graph TD
    A[User Issues Payment] --> B{Payment Received?};
    B -- No --> A;
    B -- Yes --> C[Fulfill Order];
    C --> D[Shipping Label Created];
    D --> E{Package Picked Up?};
    E -- Yes --> F[Notify Customer of Shipment];
    F --> G[Order Delivered?];
    G -- No --> F;
    G -- Yes --> H[Mark Order as Complete];
    H --> I[Send Satisfaction Survey];
    I --> J{Survey Received?};
    J -- Yes --> K[Analyze Survey Results];
    J -- No --> L[Initiate Refund Process];
    L --> C;
    K --> M[Archive Order Data];
    M --> B;
    style A fill:#f9f,stroke:#333,stroke-width:2px
    style H fill:#ccf,stroke:#333,stroke-width:2px