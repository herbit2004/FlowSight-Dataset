graph TD
    A[User Search Query] --> B{Query Analysis & Intent};
    B -- Identify Product Category --> C[Category Filter];
    B -- Identify Attributes --> D[Attribute Filter];
    C --> E[Initial Product Pool];
    D --> E;
    E --> F{Personalization Engine};
    F -- User History Available --> G[Personalized Ranking];
    F -- No User History --> H[Popularity Ranking];
    G --> I[Relevance Scoring];
    H --> I;
    I --> J[Ranking Adjustment];
    J --> K{Inventory Check};
    K -- In Stock --> L[Availability Filtering];
    K -- Out of Stock --> M[Surface Substitutes];
    L --> N[Diversity Optimization];
    M --> N;

    N --> O[Final Ranked Results];
    O --> P[Display Results to User];

    classDef filter fill:#f9f,stroke:#333,stroke-width:2px
    classDef scoring fill:#ccf,stroke:#333,stroke-width:2px
    classDef ranking fill:#cfc,stroke:#333,stroke-width:2px
    classDef display fill:#fcc,stroke:#333,stroke-width:2px

    class C,D filter;
    class I scoring;
    class G,H,J ranking;
    class P display;