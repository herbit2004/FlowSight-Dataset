flowchart TD
    A[Start] --> B{Check};
    B -- Yes --> C[Process];
    B -- No --> H[Complete];
    C --> D{Validate};
    D -- Yes --> E[Store];
    D -- No --> F[Retry];
    E --> G[Notify];
    F --> B;
    G --> H;
    H --> C;
    I[Configure] --> A;

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style H fill:#ccf,stroke:#333,stroke-width:2px