graph TD
    subgraph 用户行为
        A[用户请求] --> B(API Gateway);
    end

    subgraph 系统内部
        B --> C{鉴权 & 路由};
        C -- 用户服务 --> D[用户服务 - 获取用户信息];
        D --> E{用户缓存命中?};
        E -- 是 --> F[返回用户信息];
        E -- 否 --> G[用户数据库];
        G --> H[返回用户信息];
        H --> F;
        C -- 订单服务 --> I[订单服务 - 创建订单];
        I --> J[库存服务 - 扣减库存];
        J --> K{库存成功?};
        K -- 是 --> L[订单服务 - 写入订单数据库];
        K -- 否 --> M[订单服务 - 回滚订单];
        L --> N[返回订单结果];
        M --> N;

        F --> N;

    end

    N --> O[返回响应];