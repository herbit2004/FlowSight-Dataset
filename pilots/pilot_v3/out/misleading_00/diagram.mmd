graph TD
    A[用户请求] --> B(数据库);
    B --> C{用户已存在？};
    C -- Yes --> D[发送验证码];
    C -- No --> E[注册用户];
    E --> F(风控系统);
    F --> G{风控通过？};
    G -- Yes --> H[生成用户ID];
    G -- No --> A;
    H --> I[写入缓存];
    I --> J[发送欢迎邮件];
    J --> K(消息队列);
    K --> L[支付服务];
    L --> M{支付成功？};
    M -- Yes --> N[更新用户状态];
    M -- No --> O[返回错误];
    N --> P[登出];
    P --> Q(API网关);
    Q --> R[用户响应];
    R --> A;
    D --> S[验证码验证];
    S --> T{验证码正确？};
    T -- Yes --> U[登录];
    T -- No --> D;
    U --> V[鉴权];
    V --> W{权限足够？};
    W -- Yes --> B;
    W -- No --> O;