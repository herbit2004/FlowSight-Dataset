graph TD
    A[服务调用方] --> B{请求发送};
    B --> C{限流检查};
    C -- 通过 --> D[目标服务];
    C -- 拒绝 --> E[快速失败];
    D -- 成功 --> F[返回成功];
    D -- 失败 --> G{错误类型判断};
    G -- 可重试错误 --> H{重试计数器};
    G -- 不可重试错误 --> I[返回失败];
    H -- 重试次数 < 最大重试次数 --> J[等待策略];
    H -- 重试次数 >= 最大重试次数 --> K{熔断器状态判断};
    J --> B;
    K -- 熔断器打开 --> L[返回熔断异常];
    K -- 熔断器关闭 --> B;
    K -- 半熔断状态 --> B;
    F --> M[记录成功];
    I --> N[记录失败];
    L --> O[记录熔断];
    M --> P[响应返回];
    N --> P;
    O --> P;
    E --> P;