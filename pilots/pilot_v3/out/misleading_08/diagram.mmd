graph TD
    A[用户请求] --> B(数据库写入);
    B --> C{用户已登录?};
    C -- Yes --> D[API 网关];
    C -- No --> E[登录];
    E --> F(支付);
    F --> C;
    D --> G{黑名单?};
    G -- Yes --> H[返回错误];
    G -- No --> I[读缓存];
    I --> J(授权);
    J --> K{缓存命中?};
    K -- Yes --> L[返回数据];
    K -- No --> M[消息队列];
    M --> N(鉴权);
    N --> L;
    L --> A;
    H --> A;