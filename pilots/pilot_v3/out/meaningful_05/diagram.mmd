graph TD
    A[客户端上传文件] --> B{文件类型与大小校验};
    B -- 通过 --> C[预处理服务：生成元数据];
    B -- 失败 --> H[返回错误给客户端];
    C --> D{对象存储服务};
    D -- 上传完成 --> E[消息队列: 文件上传事件];
    D -- 上传失败 --> I[告警服务: 上传失败];
    E --> F[异步处理服务：缩略图生成];
    E --> G[异步处理服务：病毒扫描];
    F --> J[对象存储服务: 存储缩略图];
    G --> K[反病毒引擎];
    K -- 安全 --> L[更新文件元数据];
    K -- 发现病毒 --> M[隔离文件，告警];
    L --> N[完成，通知用户];

    classDef failFill fill:#f9f,stroke:#333,stroke-width:2px
    class H,I,M failFill